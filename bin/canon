}
function appFlow(s) {
  s.report.head("app-flow \u2014 every navigation the app performs is a declared edge");
  const nav = navigation(s);
  const route = (r2) => appRoute(s, r2);
  let navigations = 0;
  const undeclared = /* @__PURE__ */ new Set();
  for (const [path2, rel] of nav.screens) {
    const froms = nav.owners.get(rel) ?? [];
    if (!froms.length) continue;
    for (const t2 of sorted(routesIn(s, stripGuards(stripComments(screenSource(s, path2, nav.hooks)))))) {
      const tos = [...nav.owners].filter(([r2]) => route(r2) === route(t2)).flatMap(([, fs2]) => fs2);
      if (!tos.length) continue;
      navigations += 1;
      if (!s.edges.some((e) => froms.includes(e.from) && tos.includes(e.to))) undeclared.add(`${froms[0]} -> ${tos[0]}  (${rel} navigates to ${t2})`);
    }
  }
  const said = recorded(s);
  for (const u3 of sorted(undeclared)) {
    const key2 = u3.split("  (")[0];
    if (key2.split(" -> ").every((part) => said.includes(part))) s.report.say(`   pending: ${key2} \u2014 recorded in \`missing\``);
    else s.report.bad(u3);
  }
  reverseFlow(s, nav, navigations);
}
function sharedTargets(s, nav) {
  const known = new Set([...nav.owners.keys()].map((r2) => `/${appRoute(s, r2)}`));
  const targets = /* @__PURE__ */ new Set();
  const shared = walk2(s.srcDir).filter((f) => f.startsWith("components/") && /\.tsx?$/.test(f) || f.startsWith("hooks/") && f.endsWith(".ts"));
  for (const f of shared) {
    const text = stripComments(read(join17(s.srcDir, f)));
    routesIn(s, text).forEach((t2) => targets.add(t2));
    for (const m2 of text.matchAll(/["'`](\/[a-z(][^"'`$]*)/g)) if (known.has(`/${appRoute(s, m2[1])}`)) targets.add(m2[1]);
  }
  return targets;
}
function tabs(s) {
  const layout = walk2(s.appDir).find((f) => /(^|\/)\(tabs\)\/_layout\.tsx$/.test(f)) ?? "(tabs)/_layout.tsx";
  const dir = join17(s.appDir, dirname4(layout));
  const targets = isFile(join17(s.appDir, layout)) ? routesIn(s, stripComments(read(join17(s.appDir, layout)))) : /* @__PURE__ */ new Set();
