function canonRootFrom(start) {
  for (let dir = start; ; dir = dirname13(dir)) {
    const file2 = join44(dir, "package.json");
    if (existsSync34(file2) && JSON.parse(readFileSync32(file2, "utf8")).name === "@freetesh/canon") return dir;
    if (dirname13(dir) === dir) throw new Error(`canon cannot find its own folder above ${start}`);
  }
}
