var MODULES_BY_KIND = {
  mobile: ["docs", "knowledge", "code", "listing", "refs"],
  web: ["docs", "knowledge", "code", "refs"],
  "mobile-and-web": ["docs", "knowledge", "code", "listing", "refs"],
