function installHook(repo) {
  if (!existsSync26(join35(repo, ".git"))) return `skipped: ${repo} is not a git repo`;
  if (!existsSync26(join35(repo, ".context", "tasks.md"))) {
    const old = join35(repo, ".git", "hooks", "pre-push");
    if (existsSync26(old) && ours(old)) {
      renameSync(old, `${old}.disabled`);
