// cli/src/setup/features/features.ts
var import_yaml9 = __toESM(require_dist(), 1);
import { existsSync as existsSync44, mkdirSync as mkdirSync15, readFileSync as readFileSync41, writeFileSync as writeFileSync16 } from "node:fs";
import { homedir as homedir10 } from "node:os";
import { dirname as dirname18, join as join57 } from "node:path";
var FIELD = "features";
function assertFeature(name) {
  if (!FEATURES.includes(name)) throw new Error(`unknown feature "${name}" \u2014 choose from: ${FEATURES.join(", ")}`);
}
var userFile = () => join57(process.env.CANON_HOME ?? join57(homedir10(), ".canon"), "features.json");
function readUserFeatures() {
  try {
    const list = JSON.parse(readFileSync41(userFile(), "utf8"));
    return Array.isArray(list) ? list.filter((name) => FEATURES.includes(name)) : [];
  } catch {
    return [];
  }
}
function setUserFeature(name, isOn) {
  assertFeature(name);
  const current = readUserFeatures();
  const next = isOn ? [.../* @__PURE__ */ new Set([...current, name])] : current.filter((feature) => feature !== name);
  mkdirSync15(dirname18(userFile()), { recursive: true });
  writeFileSync16(userFile(), `${JSON.stringify(next)}
`);
  return next;
}
function setFeature(repo, name, isOn) {
  assertFeature(name);
  const file2 = join57(repo, ".context", "context.yaml");
  const exists = existsSync44(file2);
  if (!exists && !isOn) return [];
  const text = exists ? readFileSync41(file2, "utf8") : "";
  const doc = (0, import_yaml9.parseDocument)(text);
  if (doc.errors.length > 0) throw new Error(`${file2} does not parse: ${doc.errors[0].message}`);
  const current = doc.toJS()?.[FIELD] ?? [];
  const next = isOn ? [.../* @__PURE__ */ new Set([...current, name])] : current.filter((feature) => feature !== name);
  mkdirSync15(dirname18(file2), { recursive: true });
  writeFileSync16(file2, withField(text, next));
  return next;
}
function withField(text, features) {
  const block2 = features.length > 0 ? [`${FIELD}:`, ...features.map((feature) => `  - ${feature}`)] : [];
  const lines = text.split("\n");
  if (lines.at(-1) === "") lines.pop();
  const start = lines.findIndex((line) => line.startsWith(`${FIELD}:`));
  if (start === -1) return [...lines, ...block2, ""].join("\n");
  const after = lines.findIndex((line, index) => index > start && !/^(\s|$)/.test(line));
  const end = after === -1 ? lines.length : after;
  return [...lines.slice(0, start), ...block2, ...lines.slice(end), ""].join("\n");
}
var PLUGINS = { process: "canon-process", knowledge: "canon-knowledge" };
function pluginCommand(name, isOn, scope = "project") {
  const plugin = PLUGINS[name];
  return plugin ? ["plugin", isOn ? "install" : "uninstall", `${plugin}@canon`, "--scope", scope] : null;
}

// cli/src/serve/band/band.ts
var NOTHING = { root: null, stage: null, stages: [], waiting: null, running: null, problem: null, errors: [], warnings: [], features: [] };
var titleOf = (body, id) => /^# (.+)$/m.exec(body)?.[1]?.trim() ?? id;
function problemOf(record2) {
  if (!record2) return null;
  const text = (value) => value === void 0 || value === null ? null : String(value);
  return { id: record2.id, title: titleOf(record2.body, record2.id), source: text(record2.data.source), priority: text(record2.data.priority), file: record2.file };
}
function runningFacts(repo, config2) {
  const mark = readRunning(repo);
  if (!mark) return null;
  const data = allRecords(repo, config2).find((entry) => entry.id === mark.record)?.data ?? {};
  return { record: mark.record, stage: data.stage ? String(data.stage) : null, startedAt: mark.startedAt, spendUsd: Number(data.cost ?? 0), capUsd: config2.cap ?? DEFAULT_CAP_USD };
}
function markStages(config2, record2, here) {
  const stages = config2.pipelines[String(record2?.data.pipeline ?? "default")] ?? [];
  const stage2 = record2 ? stageOfRecord(config2, record2) : null;
  const at = stages.findIndex((entry) => entry.id === stage2);
  return {
    stage: stage2,
    stages: stages.map((entry, index) => ({ id: entry.id, state: index === at ? here : index < at ? "ok" : "todo" }))
  };
}
var buildBand = (start, options) => ({ ...workFacts(start, options), prices: machinePrices() });
function workFacts(start, options) {
  const repo = productRoot(start);
  const onMachine = readUserFeatures();
  if (!repo) return { product: null, ...NOTHING, features: onMachine };
  const product = basename17(repo);
  const findings = runChecks(repo, options).findings;
  const pick2 = (level) => findings.filter((finding) => finding.level === level).map(({ file: file2, message }) => ({ ...file2 ? { file: file2 } : {}, message }));
  const errors = pick2("error");
  const warnings = pick2("warn");
  let config2;
  try {
    config2 = loadConfig(repo).config;
  } catch (error62) {
    return { product, ...NOTHING, errors: errors.length ? errors : [{ message: error62.message }], warnings, features: onMachine };
  }
  const queue = queueOf(repo, config2);
  const records2 = allRecords(repo, config2);
  const current = queue.find((row) => row.waiting);
  const running = runningFacts(repo, config2);
  const focus = records2.find((record2) => record2.id === (running?.record ?? current?.id));
  const here = running ? "running" : current?.waiting ? "waiting" : "here";
  return {
    product,
    root: repo,
    ...markStages(config2, focus, here),
    waiting: current?.waiting ? { record: current.id, stage: current.waiting } : null,
    running,
    problem: problemOf(focus),
    errors,
    warnings,
    features: [.../* @__PURE__ */ new Set([...config2.features, ...onMachine])]
  };
}

