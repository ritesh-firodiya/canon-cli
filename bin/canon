    (parent) => existsSync28(join38(repo, parent)) ? readdirSync21(join38(repo, parent), { withFileTypes: true }).filter((entry) => entry.isDirectory() && existsSync28(join38(repo, parent, entry.name, "package.json"))).map((entry) => `${parent}/${entry.name}`).sort() : []
  );
