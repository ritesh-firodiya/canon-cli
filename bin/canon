}
function markRunning(repo, record2, now = /* @__PURE__ */ new Date()) {
  const file2 = runningFile(repo);
  mkdirSync11(dirname15(file2), { recursive: true });
  const mark = { record: record2, startedAt: now.toISOString(), pid: process.pid };
  writeFileSync11(file2, `${JSON.stringify(mark)}
`);
}
function clearRunning(repo) {
  rmSync2(runningFile(repo), { force: true });
}
function isAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error62) {
    return error62.code === "EPERM";
  }
}
function readRunning(repo) {
  const file2 = runningFile(repo);
  if (!existsSync36(file2)) return null;
  try {
    const mark = JSON.parse(readFileSync34(file2, "utf8"));
    if (typeof mark.record === "string" && typeof mark.pid === "number" && isAlive(mark.pid)) return mark;
  } catch {
  }
  clearRunning(repo);
  return null;
}

