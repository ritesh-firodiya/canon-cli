// cli/src/work/records/experiment.ts
function startExperiment(repo, config2, name, options) {
  const pipeline2 = options.pipeline ?? "default";
  const stages = pipelineOf(config2, pipeline2);
  const ids = stages.map((stage2) => stage2.id);
  if (!ids.includes(options.from)) throw new Error(`no stage "${options.from}" in ${pipeline2}: ${ids.join(", ")}`);
  if (options.to && options.to !== options.from && !stagesAfter(stages, options.from).has(options.to)) throw new Error(`"${options.to}" does not come after "${options.from}" in ${pipeline2}`);
  return newPage(repo, config2, "experiments", name, { status: "running", "started-at": options.from, ...options.to ? { "stops-at": options.to } : {}, ...pipeline2 === "default" ? {} : { pipeline: pipeline2 } });
}

// cli/src/work/records/queue.ts
function waitingStage(config2, data) {
  const at = data.at ?? data.stage;
  if (!at || !config2.pipelines[String(data.pipeline ?? "default")]) return null;
  const stage2 = pipelineOf(config2, String(data.pipeline ?? "default")).find((entry) => entry.id === at);
  if (data.drafting === at) return null;
  return stage2 && (stage2.gate || stage2.by === "person") && !isApproved(stage2, data) ? stage2.id : null;
}
function queueOf(repo, config2) {
  const order = Object.keys(config2.priorities);
  const rank = (priority) => priority && order.includes(priority) ? order.indexOf(priority) : order.length;
  return allRecords(repo, config2).filter((record2) => !record2.kind.closed.includes(String(record2.data.status))).map(({ id, file: file2, data }) => ({
    id,
    priority: data.priority ? String(data.priority) : null,
    status: data.status ? String(data.status) : "open",
    stage: data.at || data.stage ? String(data.at ?? data.stage) : null,
    owner: data.owner ? String(data.owner) : null,
    waiting: waitingStage(config2, data),
    file: file2
  })).sort((a2, b) => rank(a2.priority) - rank(b.priority));
}
function formatQueue(rows2) {
  if (rows2.length === 0) return "nothing open";
  return rows2.map((row) => [row.priority ?? "--", row.id.padEnd(10), row.status.padEnd(10), (row.owner ?? "no owner").padEnd(14), row.waiting ? `waits for a person at ${row.waiting}` : row.stage ?? "not started"].join("  ")).join("\n");
}

// cli/src/work/records/set.ts
function setRecordFields(repo, config2, recordId, fields) {
  const record2 = findRecord(repo, config2, recordId);
  for (const [field, value] of Object.entries(fields)) {
    if (RESERVED_FIELDS.includes(field)) throw new Error(`${field} is written by canon, not by hand`);
    const problem = fieldProblem(config2, record2.kind, field, value);
    if (problem) throw new Error(problem);
  }
  setFields(repo, record2.file, fields);
}
function markDone(repo, config2, recordId) {
  const record2 = findRecord(repo, config2, recordId);
  const status = record2.kind.closed[0];
  if (!status) throw new Error(`${record2.kind.folder} has no closing status: set closed: under records`);
  setFields(repo, record2.file, { status });
  return status;
}

// cli/src/work/records/records.command.ts
function parsePairs(pairs) {
  return Object.fromEntries(
    pairs.map((pair) => {
      const at = pair.indexOf("=");
      if (at < 1) throw new Error(`needs field=value, not "${pair}"`);
      return [pair.slice(0, at), pair.slice(at + 1)];
    })
  );
}
function requireNoRun() {
  if (process.env.CANON_RUN) throw new Error("an agent run cannot use this: only the last stage closes work, and it edits the page itself");
}
var collect = (value, list) => [...list, value];
