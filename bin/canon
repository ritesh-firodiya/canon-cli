// cli/src/lib/files.ts
import { existsSync as existsSync5, readdirSync as readdirSync4, statSync } from "node:fs";
import { dirname as dirname3, join as join6, relative, resolve as resolve4 } from "node:path";
function listFiles(root, dir, test) {
  const start = join6(root, dir);
  if (!existsSync5(start)) return [];
  const found = [];
  const walk3 = (current) => {
    for (const entry of readdirSync4(current, { withFileTypes: true })) {
      const full = join6(current, entry.name);
      if (entry.isDirectory() || entry.isSymbolicLink() && isDirectory(full)) walk3(full);
      else if (test(entry.name)) found.push(relative(root, full));
    }
  };
  walk3(start);
  return found.sort();
}
function isDirectory(path2) {
  return existsSync5(path2) && statSync(path2).isDirectory();
}
function productRoot(start) {
  let folder = resolve4(start);
  while (!existsSync5(join6(folder, ".context"))) {
    if (dirname3(folder) === folder) return null;
    folder = dirname3(folder);
  }
  return folder;
}

// cli/src/enforce/checks/wiki-frontmatter.ts
var REQUIRED_FIELDS = ["last-verified"];
var PLACEHOLDER = /\bTBD\b|\bnone yet\b|\bpopulate when\b/i;
var CODE_BLOCK = /```[\s\S]*?```/g;
var STALE_AFTER_DAYS = 90;
var DAY_MS = 864e5;
var NOT_PAGES = ["index.md", "CLAUDE.md"];
var OLDEST_SHOWN = 3;
function wikiPages(repo) {
  return listFiles(repo, ".context/wiki", (name) => name.endsWith(".md") && !NOT_PAGES.includes(name));
}
function asDate(value) {
  const date5 = value instanceof Date ? value : new Date(String(value));
  return Number.isNaN(date5.getTime()) ? null : date5;
}
var wikiFrontmatter = {
  id: "wiki-frontmatter",
  module: "docs",
  description: "every wiki page has last-verified and no placeholder text; a type, if set, matches its folder; ids are unique; nothing stale",
  run({ repo, config: config2, today }) {
    const folderByType = { ...WIKI_FOLDER_BY_TYPE, ...Object.fromEntries(config2.wiki.types.map((entry) => [entry.type, entry.folder])) };
    const sectionsByType = new Map(config2.wiki.types.map((entry) => [entry.type, entry.sections]));
    const findings = [];
    const add = (level, file2, message) => findings.push({ check: "wiki-frontmatter", level, file: file2, message });
    const filesById = /* @__PURE__ */ new Map();
    const stale = [];
    for (const file2 of wikiPages(repo)) {
      const folder = file2.split("/")[2];
      const { data, body } = parseFrontmatter(readFileSync4(join7(repo, file2), "utf8"));
      if (!data) {
        add("error", file2, "no frontmatter");
        continue;
      }
      const missing = REQUIRED_FIELDS.filter((field) => data[field] === void 0 || data[field] === null);
      if (missing.length > 0) add("error", file2, `missing ${missing.join(", ")}`);
      const expected = folderByType[String(data.type)];
      if (data.type && expected !== folder) add("error", file2, `type ${data.type} does not belong in ${folder}/`);
      if (!data.type && !Object.values(folderByType).includes(folder)) add("error", file2, `${folder}/ is not a wiki folder`);
      const sections = sectionsByType.get(String(data.type));
      if (sections) {
        const headings = new Set(body.split("\n").flatMap((line) => line.startsWith("## ") ? [line.slice(3).trim()] : []));
        const absent = sections.filter((section2) => !headings.has(section2));
        if (absent.length > 0) add("error", file2, `missing sections: ${absent.join(", ")}`);
      }
      const placeholder = body.replace(CODE_BLOCK, "").match(PLACEHOLDER);
      if (placeholder) add("warn", file2, `placeholder "${placeholder[0]}" \u2014 write the fact or delete the section`);
      const verified = asDate(data["last-verified"]);
      const age = verified ? Math.floor((today.getTime() - verified.getTime()) / DAY_MS) : 0;
      if (verified && age > STALE_AFTER_DAYS) stale.push({ file: file2, age });
      if (verified && age < 0) add("error", file2, `last-verified ${data["last-verified"]} is in the future`);
      if (data.id) filesById.set(String(data.id), [...filesById.get(String(data.id)) ?? [], file2]);
    }
    if (stale.length > 0) {
      const oldest = stale.sort((a2, b) => b.age - a2.age).slice(0, OLDEST_SHOWN).map(({ file: file2, age }) => `${file2.replace(".context/wiki/", "")} (${age}d)`);
      const pages2 = stale.length === 1 ? "1 page" : `${stale.length} pages`;
      add("warn", ".context/wiki", `${pages2} last verified over ${STALE_AFTER_DAYS} days ago \u2014 oldest: ${oldest.join(", ")}`);
    }
    for (const [id, files] of filesById) {
      if (files.length > 1) add("error", files[1], `duplicate id ${id} (also ${files[0]})`);
    }
    return findings;
  }
};

// cli/src/enforce/checks/drift.ts
var CODE_BLOCK2 = /```[\s\S]*?```/g;
var BACKTICKED = /`([^`\n]+)`/g;
var EXTENSION = /\.[A-Za-z][A-Za-z0-9]*$/;
var NOT_A_PATH = /\s|:\/\/|[*?{]|^(~\/|\/|\.\.?\/|\.context\/)/;
var DAY_MS2 = 864e5;
function namedPaths(body) {
  const tokens3 = [...body.replace(CODE_BLOCK2, "").matchAll(BACKTICKED)].map((match) => match[1]);
  const paths = tokens3.filter((token) => token.includes("/") && !NOT_A_PATH.test(token) && EXTENSION.test(token) && !token.endsWith(".md"));
  return [...new Set(paths)];
}
function lastChanged(repo, path2) {
  const out = spawnSync2("git", ["-C", repo, "log", "-1", "--format=%cI", "--", path2], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).stdout?.trim();
  return out ? asDate(out) : null;
}
function runDrift(repo) {
  const findings = [];
  for (const file2 of wikiPages(repo)) {
    const { data, body } = parseFrontmatter(readFileSync5(join8(repo, file2), "utf8"));
    const verified = data ? asDate(data["last-verified"]) : null;
    if (!verified) continue;
    const named = namedPaths(body);
    const gone = named.filter((path2) => !existsSync6(join8(repo, path2)));
    const changed = named.filter((path2) => !gone.includes(path2) && (lastChanged(repo, path2)?.getTime() ?? 0) > verified.getTime() + DAY_MS2);
    if (gone.length > 0) findings.push({ check: "drift", level: "error", file: file2, message: `a file no longer in the tree: ${gone.join(", ")}` });
    if (changed.length > 0) {
      findings.push({ check: "drift", level: "warn", file: file2, message: `the code changed after ${verified.toISOString().slice(0, 10)}: ${changed.join(", ")}` });
    }
  }
  return findings;
}
var drift = {
  id: "drift",
  module: "docs",
  description: "each wiki page matches the code it names: a named file exists, and none changed after the page's last-verified date",
  run: ({ repo }) => runDrift(repo)
};

// cli/src/enforce/checks/format.ts
var MARK = { error: "\u2717", warn: "!" };
function plural2(count, word) {
  return `${count} ${word}${count === 1 ? "" : "s"}`;
}
function counts(report) {
  return {
    errors: report.findings.filter((f) => f.level === "error").length,
    warnings: report.findings.filter((f) => f.level === "warn").length
  };
}
function formatReports(reports, options = {}) {
  const lines = [];
  let errors = 0;
  let warnings = 0;
  for (const report of reports) {
    const count = counts(report);
    errors += count.errors;
    warnings += count.warnings;
    const clean = report.findings.length === 0;
    if (clean && options.quiet) continue;
    const summary = clean ? "ok" : `${plural2(count.errors, "error")}, ${plural2(count.warnings, "warning")}`;
    lines.push(`${report.name}  ${summary}`);
    for (const finding of report.findings) {
      const message = finding.message.replace(/\n/g, "\n      ");
      lines.push(`  ${MARK[finding.level]} ${finding.check}  ${finding.file ?? ""}  ${message}`.replace(/  +$/, ""));
    }
  }
  lines.push(`${plural2(reports.length, "product")} \xB7 ${plural2(errors, "error")} \xB7 ${plural2(warnings, "warning")}`);
  return lines.join("\n");
}
function exitCode(reports) {
  return reports.some((report) => report.findings.some((f) => f.level === "error")) ? 1 : 0;
}

// cli/src/enforce/checks/check.ts
import { existsSync as existsSync23, readdirSync as readdirSync16 } from "node:fs";
