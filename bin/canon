    $comment: "GENERATED by `canon flow` from local Claude transcripts, git, GitHub and release.yml. Counts only. Do not hand-edit.",
    updated: isoDay(/* @__PURE__ */ new Date()),
    since: first ? isoDay(first) : null,
    stages: stages.map((id, i2) => ({ id, count: furthest.filter((f) => f >= i2).length })),
    medianHours: Object.fromEntries([...waits].map(([k, v]) => {
      const m2 = median(v);
      return [k, m2 === null ? null : Math.round(m2 * 10) / 10];
    }))
  };
}

// cli/src/learn/flow/print.ts
function printFlow(env2, products, options) {
  const workspace = requireWorkspace(env2);
  for (const product of products) if (!existsSync33(join43(workspace, product, ".git"))) throw new Error(`${product}: not a repo under ${workspace}`);
  const formerly = new Map(findProducts(workspace).map((repo) => [resolve11(repo).split("/").pop(), loadConfig(repo).config.formerly]));
  const sessions = allSessions(workspace);
  for (const product of products) {
    const result = flow(workspace, product, sessions, formerly.get(product) ?? []);
    console.log(`${product} ${result.stages.map((s) => `${s.id} ${s.count}`).join(" \u2192 ")} | since ${result.since}`);
    if (!options.write) continue;
    const out = join43(workspace, product, ".context", "metrics", "flow.json");
    mkdirSync9(dirname12(out), { recursive: true });
    writeFileSync9(out, `${JSON.stringify(result, null, 2)}
`);
  }
}

