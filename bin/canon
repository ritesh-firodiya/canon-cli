}
function copy(s) {
  s.report.head("copy \u2014 every string a dialog or a toast shows appears in the set");
  if (!isDir(s.appDir)) {
    s.report.say(`   skipped \u2014 no app at ${s.appDir}`);
    return;
  }
  const drawn = flat(sorted(s.onDisk).map((f) => read(join18(s.dir, f))).join(" "));
  const words = dictionary(s);
  const raisers = s.web ? /(?:\btoast|window\.confirm)\(/g : /(?:Alert\.alert|showToast)\(/g;
  const before = s.report.fail;
  let checked = 0;
  for (const path2 of sources(s.srcDir)) {
    const text = read(path2);
    for (const m2 of text.matchAll(raisers)) {
      const call = callArguments(text, m2.index + m2[0].length - 1).replace(T_CALL, (whole, key2) => words.has(key2) ? JSON.stringify(words.get(key2)) : whole);
      for (const lit of call.replace(TEMPLATE, "").matchAll(STRING)) {
        const piece = flat((lit[1] ?? lit[2]).replaceAll('\\"', '"').replaceAll("\\'", "'"));
        if (!isCopy(piece)) continue;
        checked += 1;
        if (!drawn.includes(piece)) s.report.bad(`src/${path2.slice(s.srcDir.length + 1)} puts "${piece.length < 60 ? piece : `${piece.slice(0, 57)}...`}" on screen and no wireframe draws it`);
      }
    }
  }
  const undrawn = s.report.fail - before;
  s.report.say(`   ${checked} dialog and toast strings checked${undrawn ? `, ${undrawn} undrawn` : ", all drawn"}`);
}

