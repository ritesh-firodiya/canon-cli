// cli/src/lib/frontmatter.ts
var import_yaml3 = __toESM(require_dist(), 1);
var FRONTMATTER = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/;
function parseFrontmatter(text) {
  const match = FRONTMATTER.exec(text);
  if (!match) return { data: null, body: text };
  try {
    const data = (0, import_yaml3.parse)(match[1]);
    const isObject2 = typeof data === "object" && data !== null && !Array.isArray(data);
    return { data: isObject2 ? data : null, body: text.slice(match[0].length) };
  } catch {
    return { data: null, body: text.slice(match[0].length) };
  }
}

// cli/src/work/records/records.ts
var RECORD_FILE = /^(\d{4})-.+\.md$/;
var FRONTMATTER2 = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/;
function recordFiles(repo, kind) {
  const dir = join4(repo, ".context", kind.folder);
  return existsSync3(dir) ? readdirSync3(dir).filter((name) => kind.named ? name.endsWith(".md") && name !== "index.md" : RECORD_FILE.test(name)).sort() : [];
}
function allRecords(repo, config2) {
  return config2.records.flatMap(
    (kind) => recordFiles(repo, kind).flatMap((name) => {
      const file2 = join4(".context", kind.folder, name);
      const { data, body } = parseFrontmatter(readFileSync3(join4(repo, file2), "utf8"));
      return data ? [{ id: String(kind.named ? data.name : data.id), file: file2, kind, data, body }] : [];
    })
  );
}
function findRecord(repo, config2, id) {
  const found = allRecords(repo, config2).find((record2) => record2.id === id);
  if (!found) throw new Error(`no record ${id} in ${repo}`);
  return found;
}
function setFields(repo, file2, fields) {
  const path2 = join4(repo, file2);
  const text = readFileSync3(path2, "utf8");
  const match = FRONTMATTER2.exec(text);
  if (!match) throw new Error(`${file2} has no frontmatter`);
  const doc = (0, import_yaml4.parseDocument)(match[1]);
  for (const [key2, value] of Object.entries(fields)) {
    if (value === null) doc.delete(key2);
    else doc.set(key2, doc.createNode(value));
  }
  writeFileSync2(path2, `---
${doc.toString().trimEnd()}
---
${text.slice(match[0].length)}`);
}
function appendToSection(repo, file2, section2, lines) {
  const path2 = join4(repo, file2);
  const text = readFileSync3(path2, "utf8");
  const heading = new RegExp(`^## ${section2}[ \\t]*$`, "m").exec(text);
  if (!heading) {
    writeFileSync2(path2, `${text.trimEnd()}

## ${section2}
${lines}
`);
    return;
  }
  const start = heading.index + heading[0].length;
  const next = text.slice(start).search(/^## /m);
  const end = next === -1 ? text.length : start + next;
  writeFileSync2(path2, `${text.slice(0, end).trimEnd()}
${lines}
${next === -1 ? "" : `
${text.slice(end)}`}`);
}
var toSlug = (text) => text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48) || "record";
function createRecord(repo, kind, slug, fields, body) {
  const dir = join4(".context", kind.folder);
  mkdirSync2(join4(repo, dir), { recursive: true });
  if (kind.named) {
    const name = toSlug(slug);
    const file3 = join4(dir, `${name}.md`);
    if (existsSync3(join4(repo, file3))) throw new Error(`${kind.folder} already has one named ${name}: names are unique`);
    writeFileSync2(join4(repo, file3), `---
${(0, import_yaml4.stringify)({ name, ...fields }).trimEnd()}
---
${body.trimEnd()}
`);
    return { id: name, file: file3 };
  }
  const last = recordFiles(repo, kind).map((name) => Number(name.slice(0, 4))).reduce((a2, b) => Math.max(a2, b), 0);
  const number4 = String(last + 1).padStart(4, "0");
  const id = `${kind.prefix}-${number4}`;
  const file2 = join4(dir, `${number4}-${toSlug(slug)}.md`);
  writeFileSync2(join4(repo, file2), `---
${(0, import_yaml4.stringify)({ id, ...fields }).trimEnd()}
---
${body.trimEnd()}
`);
  return { id, file: file2 };
}
function kindByFolder(config2, folder) {
  const kind = config2.records.find((entry) => entry.folder === folder);
  if (!kind) throw new Error(`this repo has no ${folder} records (see records: in context.yaml)`);
  return kind;
}
var approvalsOf = (data) => Array.isArray(data.approvals) ? data.approvals : [];

// cli/src/work/pipeline/pipeline.ts
function stagesOf(repo, config2, name = "default") {
  const approved = new Set(allRecords(repo, config2).flatMap((record2) => approvalsOf(record2.data).map((approval) => approval.stage)));
  const stages = pipelineOf(config2, name);
  return stages.map((stage2) => ({
    id: stage2.id,
    after: afterOf(stages, stage2),
    gate: stage2.gate,
    startedAt: stage2.done.find((path2) => existsSync4(join5(repo, path2))) ?? null,
    approved: stage2.gate ? approved.has(stage2.id) : null
  }));
}
function pipelineOf(config2, name) {
  const stages = config2.pipelines[name];
  if (!stages) throw new Error(`no pipeline "${name}" \u2014 pipelines here: ${Object.keys(config2.pipelines).join(", ")}`);
  return stages;
}
function stageOfKind(stages, record2) {
  return stages.find((stage2) => stage2.id === record2.kind.folder.replace(/s$/, "")) ?? stages.find((stage2) => stage2.done.includes(join5(".context", record2.kind.folder)));
}
function startOf(stages, record2) {
  const started = stages.find((stage2) => stage2.id === record2.data["started-at"]);
  return (started ?? stageOfKind(stages, record2) ?? stages[0])?.id;
}
function isApproved(stage2, data) {
  const people = approvalsOf(data).filter((approval) => approval.stage === stage2.id && (!stage2.approvers || stage2.approvers.includes(approval.by)));
  return new Set(people.map((approval) => approval.by)).size >= (stage2.required ?? 1);
}
function stageOf(config2, record2, stageId) {
  const stages = pipelineOf(config2, String(record2.data.pipeline ?? "default"));
  const needing = stages.filter((stage3) => stage3.gate || stage3.by === "person");
  const stage2 = needing.find((entry) => entry.id === stageId);
  if (!stage2) throw new Error(`"${stageId}" needs no approval here \u2014 stages that do: ${needing.map((entry) => entry.id).join(", ") || "none"}`);
  return stage2;
}
function approveStage(repo, config2, recordId, stageId, by, note, now = /* @__PURE__ */ new Date()) {
  const record2 = findRecord(repo, config2, recordId);
  const stage2 = stageOf(config2, record2, stageId);
  if (stage2.approvers && !stage2.approvers.includes(by)) throw new Error(`${by} cannot approve ${stageId} \u2014 approvers: ${stage2.approvers.join(", ")}`);
  if (approvalsOf(record2.data).some((approval2) => approval2.stage === stageId && approval2.by === by)) throw new Error(`${by} already approved ${stageId} on ${recordId}`);
  const approval = { stage: stageId, by, at: now.toISOString(), ...note ? { note } : {} };
  setFields(repo, record2.file, { approvals: [...approvalsOf(record2.data), approval] });
  return approval;
}
function rejectStage(repo, config2, recordId, stageId, by, note, now = /* @__PURE__ */ new Date()) {
  const record2 = findRecord(repo, config2, recordId);
  const stages = pipelineOf(config2, String(record2.data.pipeline ?? "default"));
  if (!stages.some((stage2) => stage2.id === stageId)) throw new Error(`no stage "${stageId}" here: ${stages.map((stage2) => stage2.id).join(", ")}`);
  const redone = /* @__PURE__ */ new Set([stageId, ...stagesAfter(stages, stageId)]);
  setFields(repo, record2.file, {
    approvals: approvalsOf(record2.data).filter((approval) => !redone.has(approval.stage)),
    completed: (record2.data.completed ?? []).filter((id) => !redone.has(id)),
    rejections: [...record2.data.rejections ?? [], { stage: stageId, by, at: now.toISOString(), note }]
  });
}
function stageOfRecord(config2, record2) {
  const stages = pipelineOf(config2, String(record2.data.pipeline ?? "default"));
  const saved = stages.find((stage2) => stage2.id === (record2.data.at ?? record2.data.stage));
  return (saved ?? stageOfKind(stages, record2))?.id ?? null;
}

// cli/src/work/pipeline/approve.command.ts
function personName(root) {
  try {
    return execFileSync("git", ["-C", root, "config", "user.name"], { encoding: "utf8" }).trim() || "unknown";
  } catch {
    return "unknown";
  }
}
function requirePerson() {
  if (!process.stdin.isTTY || process.env.CANON_RUN) throw new Error("approvals are for people: run this yourself in a terminal");
}
function registerApprove(program3) {
  program3.command("approve").description("record that a person reviewed and approved a stage on a record, dated now (needs a terminal: an agent cannot run it)").argument("<stage>", "the stage's id in the record's pipeline").argument("[repo]", "product repo", ".").requiredOption("--record <id>", "the record being approved, like PLAN-0001").option("--note <text>", "what was reviewed", "").action((stageId, repo, options) => {
    requirePerson();
    const root = resolve3(repo);
    const approval = approveStage(root, loadConfig(root).config, options.record, stageId, personName(root), options.note);
    console.log(`${options.record}: ${stageId} approved by ${approval.by} at ${approval.at}`);
  });
  program3.command("reject").description("send a stage back with your reason: the next run does it again and is told why (needs a terminal)").argument("<stage>", "the stage's id in the record's pipeline").argument("[repo]", "product repo", ".").requiredOption("--record <id>", "the record, like PLAN-0001").requiredOption("--note <text>", "what must change").action((stageId, repo, options) => {
    requirePerson();
    const root = resolve3(repo);
    rejectStage(root, loadConfig(root).config, options.record, stageId, personName(root), options.note);
    console.log(`${options.record}: ${stageId} sent back. canon run ${options.record} does it again`);
  });
}

