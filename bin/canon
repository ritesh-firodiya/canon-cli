      else if (match[1] === "cli" && !tools.has(match[2])) add(`cli ${match[2]} is not in doctor.tools \u2014 canon doctor cannot report it missing`);
      return findings;
    });
  }
};

// cli/src/enforce/checks/tasks.ts
import { existsSync as existsSync22, readFileSync as readFileSync19 } from "node:fs";
import { join as join30 } from "node:path";
var TASKS = ".context/tasks.md";
var COMMENT = /<!--[\s\S]*?-->/g;
var ITEM = /^(?:\d+\.|[-*]) \[[ xX]\] +(T\d+\b)?/gm;
var ISO_DATE = /\d{4}-\d{2}-\d{2}/;
var BLOCKED_FIELDS = ["blocked-by", "unblock", "next-check"];
function sectionOf(text, name) {
  const clean = text.replace(COMMENT, "");
  const headings = [...clean.matchAll(/^## +(\S[^\n]*?)[ \t]*$/gm)];
  const at = headings.findIndex((heading) => heading[1].startsWith(name));
  if (at === -1) return "";
  const start = headings[at].index + headings[at][0].length;
  return clean.slice(start, headings[at + 1]?.index ?? clean.length);
}
function fieldOf(item, field) {
  const found = new RegExp(`(?<![\\w-])${field}:[ \\t]*([^\\n]*)`).exec(item);
  return found ? found[1].trim() : null;
}
function asDate2(value) {
  const found = ISO_DATE.exec(value);
  if (!found) return null;
  const date5 = /* @__PURE__ */ new Date(`${found[0]}T00:00:00Z`);
  return Number.isNaN(date5.getTime()) || date5.toISOString().slice(0, 10) !== found[0] ? null : date5;
}
var tasks = {
  id: "tasks",
  module: null,
  description: "every blocked task has an id, blocked-by, unblock and next-check; a passed date is a note",
  run({ repo, today }) {
    const path2 = join30(repo, TASKS);
    if (!existsSync22(path2)) return [];
    const text = readFileSync19(path2, "utf8");
    const findings = [];
    const add = (level, message) => findings.push({ check: "tasks", level, file: TASKS, message });
    const horizon = /^horizon:\s*(\S+)/m.exec(text);
    const horizonDate = horizon ? asDate2(horizon[1]) : null;
    if (horizonDate && horizonDate < today) add("warn", `past its horizon (${horizon[1]}) \u2014 regenerate it`);
    const blocked = sectionOf(text, "Blocked");
    const starts = [...blocked.matchAll(ITEM)];
    starts.forEach((start, index) => {
      const item = blocked.slice(start.index, starts[index + 1]?.index ?? blocked.length);
      const id = start[1];
      if (!id) return add("error", `blocked item without a task id: ${item.split("\n")[0].trim().slice(0, 60)}`);
      for (const field of BLOCKED_FIELDS) if (!fieldOf(item, field)) add("error", `${id} is blocked without ${field}:`);
      const check2 = fieldOf(item, "next-check") ?? "";
      if (ISO_DATE.test(check2)) {
        const on = asDate2(check2);
        if (!on) add("error", `${id} next-check: ${check2} is not a date`);
        else if (on < today) add("warn", `${id} was to be checked on ${check2}`);
      }
    });
    return findings;
  }
};

