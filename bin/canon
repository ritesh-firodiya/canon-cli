// cli/src/enforce/checks/one-home.ts
import { readFileSync as readFileSync14 } from "node:fs";
import { join as join25 } from "node:path";
var MIN_CHARS = 60;
var SENTENCE = /[^.!?\n]+[.!?]/g;
var CODE_BLOCK4 = /```[\s\S]*?```/g;
var SKIPPED = /^\.context\/(designs|packs)\//;
var normal = (text) => text.toLowerCase().replace(/[`*_[\]()]/g, "").replace(/\s+/g, " ").trim();
function sentences(text) {
  const body = parseFrontmatter(text).body.replace(CODE_BLOCK4, "");
  return (body.match(SENTENCE) ?? []).map(normal).filter((sentence) => sentence.length >= MIN_CHARS && !sentence.startsWith("<!--"));
}
var oneHome = {
  id: "one-home",
  module: "docs",
  description: "each fact has one home: no sentence of 60 or more characters appears in two .context pages (C-02)",
  run({ repo }) {
    const findings = [];
    const seen = /* @__PURE__ */ new Map();
    const pages2 = listFiles(repo, ".context", (name) => name.endsWith(".md")).filter((file2) => !SKIPPED.test(file2));
    for (const file2 of pages2) {
      for (const sentence of new Set(sentences(readFileSync14(join25(repo, file2), "utf8")))) {
        const home = seen.get(sentence);
        if (!home) seen.set(sentence, file2);
        else if (home !== file2) findings.push({ check: "one-home", level: "warn", file: file2, message: `repeats ${home}: "${sentence.slice(0, 70)}\u2026" \u2014 keep it in one page and link to it` });
      }
    }
    return findings;
  }
};

// cli/src/enforce/checks/pipeline.ts
var isAddress = (source) => /^https?:\/\//.test(source);
var pipeline = {
  id: "pipeline",
  module: null,
  description: "no record passes a stage without doing it or recording why it skipped, or passes a gate or a check without its evidence; triggers and checks name real sources",
  run({ repo, config: config2 }) {
    const file2 = ".context/context.yaml";
    const finding = (message, where = file2) => ({ check: "pipeline", level: "error", file: where, message });
    const connectors = config2.connectors.map((entry) => entry.id);
    const sources3 = [...BUILT_IN_TRIGGER_SOURCES, ...connectors];
    const triggers = config2.triggers.flatMap((entry) => [
      ...sources3.includes(entry.source) ? [] : [finding(`trigger "${entry.id}" reads from ${entry.source}, which is not a connector or one of ${BUILT_IN_TRIGGER_SOURCES.join(", ")}`)],
      ...entry.pipeline && !config2.pipelines[entry.pipeline] ? [finding(`trigger "${entry.id}" uses pipeline ${entry.pipeline}, which does not exist`)] : []
    ]);
    const verifySources = Object.values(config2.pipelines).flat().flatMap(
      (stage2) => (stage2.verify ?? []).filter((source) => !connectors.includes(source) && !isAddress(source)).map((source) => finding(`stage "${stage2.id}" verifies against ${source}, which is not a connector or an address`))
    );
    const flows = allRecords(repo, config2).flatMap((record2) => {
      const name = String(record2.data.pipeline ?? "default");
      const stages = config2.pipelines[name];
      if (!stages) return record2.data.pipeline ? [finding(`follows pipeline ${name}, which does not exist`, record2.file)] : [];
      const ownStage = stageOfKind(stages, record2)?.id;
      const completed = /* @__PURE__ */ new Set([...record2.data.completed ?? [], ...ownStage ? [ownStage] : []]);
      const skipped = new Set((record2.data.skipped ?? []).map((entry) => entry.stage));
      const verified = new Set(record2.data.verified ?? []);
      const current = stages.find((stage2) => stage2.id === record2.data.stage);
      const start = startOf(stages, record2) ?? "";
      const fromStart = /* @__PURE__ */ new Set([start, ...stagesAfter(stages, start)]);
      const before = current ? stagesBefore(stages, current.id) : /* @__PURE__ */ new Set();
      const passed = stages.filter((stage2) => before.has(stage2.id) && fromStart.has(stage2.id));
      return [
        ...passed.filter((stage2) => !completed.has(stage2.id) && !skipped.has(stage2.id)).map((stage2) => finding(`reached "${record2.data.stage}" with "${stage2.id}" neither done nor skipped with a reason`, record2.file)),
        ...passed.filter((stage2) => stage2.gate && !isApproved(stage2, record2.data) && !skipped.has(stage2.id)).map((stage2) => finding(`reached "${record2.data.stage}" before gate "${stage2.id}" was approved \u2014 a person runs \`canon approve ${stage2.id} --record ${record2.id}\``, record2.file)),
        ...stages.filter((stage2) => stage2.verify?.length && completed.has(stage2.id) && !verified.has(stage2.id)).map((stage2) => finding(`"${stage2.id}" passed with no check against ${stage2.verify?.join(", ")}: no ## Checked entry or --unverified reason`, record2.file))
      ];
    });
    return [...triggers, ...verifySources, ...flows];
  }
};

// cli/src/enforce/checks/records.ts
import { readFileSync as readFileSync15 } from "node:fs";
import { basename as basename5, join as join26 } from "node:path";

// cli/src/work/records/fields.ts
var RESERVED_FIELDS = ["id", "name", "approvals", "rejections", "completed", "skipped", "verified", "stage", "at", "drafting", "cost", "rules", "sources"];
var OUTCOMES = ["retained", "discarded", "retried"];
var DATE = /^\d{4}-\d{2}-\d{2}$/;
var isDate = (value) => DATE.test(value) && !Number.isNaN(Date.parse(value));
function ruleProblem(rule, text) {
  if (Array.isArray(rule)) return rule.includes(text) ? null : `is not one of ${rule.join(", ")}`;
  if (rule === "date") return isDate(text) ? null : "is not a date like 2026-11-02";
  if (rule === "number") return text !== "" && !Number.isNaN(Number(text)) ? null : "is not a number";
  if (rule === "date-range") {
    const [start, end, ...rest] = text.split("..");
    return isDate(start) && end !== void 0 && isDate(end) && rest.length === 0 && start <= end ? null : "is not a date range like 2026-11-02..2026-12-01";
  }
  if (rule === "link") return /^(https?:\/\/\S+|[A-Z]+-\d{4}|[a-z0-9-]+)$/.test(text) ? null : "is not a record or an address";
  return null;
}
function fieldProblem(config2, kind, field, value) {
  const text = String(value ?? "");
  if (kind.removed.includes(field)) return `${field} is removed for ${kind.folder} here`;
  if (field === "status") return kind.statuses.includes(text) ? null : `status ${text} is not one of ${kind.statuses.join(", ")}`;
  if (field === "priority") return text in config2.priorities ? null : `priority ${text} is not one of ${Object.keys(config2.priorities).join(", ")}`;
  if (field === "outcome") return OUTCOMES.includes(text) ? null : `outcome ${text} is not one of ${OUTCOMES.join(", ")}`;
  const rule = kind.fields[field];
  const problem = rule ? ruleProblem(rule, text) : null;
  return problem ? `${field} ${text} ${problem}` : null;
}

// cli/src/enforce/checks/records.ts
var NEVER_SHIPPED = ["shelved", "superseded"];
var STORE_COPY = /^## Store copy[ \t]*\n([\s\S]*?)(?=^## |(?![\s\S]))/m;
var hasSection = (body, section2) => new RegExp(`^## ${section2}[ \\t]*$`, "m").test(body);
function experimentWarnings(folder, data, body) {
  const wanted = [...folder === "experiments" ? ["Hypothesis", "Metric"] : [], ...data.outcome || folder === "experiments" && data.status === "done" ? ["Result"] : []];
  return wanted.filter((section2) => !hasSection(body, section2)).map((section2) => `no ## ${section2} section`);
}
function storeCopyRule(folder, data, body) {
  if (folder !== "features" || data.type !== "feature") return [];
  const released = /\d+\.\d+\.\d+/.test(String(data.release ?? "")) && !NEVER_SHIPPED.includes(String(data.status));
  const copy2 = STORE_COPY.exec(body.replace(/<!--[\s\S]*?-->/g, ""));
  return released && !(copy2 && /^>[ \t]*\S/m.test(copy2[1])) ? [`ships in ${data.release} with no "> \u2026" line under ## Store copy`] : [];
}
var records = {
  id: "records",
  module: "docs",
  description: "each record has a unique id matching its file, its values fit the repo's rules, what the repo requires is there, and links name records that exist",
  run({ repo, config: config2 }) {
    const pages2 = config2.records.flatMap(
      (kind) => listFiles(repo, `.context/${kind.folder}`, (name) => kind.named ? name.endsWith(".md") && name !== "index.md" : /^\d{4}-.+\.md$/.test(name)).map((file2) => ({ kind, file: file2, ...parseFrontmatter(readFileSync15(join26(repo, file2), "utf8")) }))
    );
    const idOf = (kind, data) => String((kind.named ? data?.name : data?.id) ?? "");
    const ids = pages2.map((page) => idOf(page.kind, page.data));
    const known = new Set(ids);
    const prefixes = config2.records.map((kind) => kind.prefix).filter(Boolean);
    const recordId = new RegExp(`\\b(?:${prefixes.join("|") || "$^"})-\\d{4}\\b`, "g");
    return pages2.flatMap(({ kind, file: file2, data, body }) => {
      const finding = (message, level = "error") => ({ check: "records", level, file: file2, message });
      if (!data) return [finding("no frontmatter")];
      const idField = kind.named ? "name" : "id";
      const id = idOf(kind, data);
      const expected = kind.named ? basename5(file2, ".md") : `${kind.prefix}-${file2.match(/(\d{4})-[^/]+$/)?.[1]}`;
      const links2 = Object.entries(data).flatMap(([field, value]) => field === idField ? [] : String(value ?? "").match(recordId) ?? []);
      const experiment = data.experiment && !known.has(String(data.experiment)) ? [String(data.experiment)] : [];
      const errors = [
        ...id ? id === expected ? [] : [`${idField} ${id} should be ${expected}`] : [`missing ${idField}`],
        ...id && ids.filter((other) => other === id).length > 1 ? [`${idField} ${id} is used by more than one record`] : [],
        ...Object.entries(data).flatMap(([field, value]) => {
          if (field === idField || value === null || value === void 0) return [];
          const problem = fieldProblem(config2, kind, field, value);
          return problem ? [problem] : [];
        }),
        ...kind.required.flatMap((need) => {
          if (need.startsWith("## ")) return hasSection(body, need.slice(3)) ? [] : [`missing section ${need}`];
          return data[need] === void 0 || data[need] === null || data[need] === "" ? [`missing field ${need}`] : [];
        }),
        ...storeCopyRule(kind.folder, data, body),
        ...[...links2, ...experiment].filter((link) => !known.has(link)).map((link) => `links to ${link}, which does not exist`)
      ];
      return [...errors.map((message) => finding(message)), ...experimentWarnings(kind.folder, data, body).map((message) => finding(message, "warn"))];
    });
  }
};

// cli/src/enforce/checks/refs.ts
import { spawnSync as spawnSync7 } from "node:child_process";
import { existsSync as existsSync21, readdirSync as readdirSync15, readFileSync as readFileSync17, statSync as statSync3 } from "node:fs";
import { dirname as dirname5, join as join28, normalize as normalize2 } from "node:path";

// cli/src/enforce/checks/shared-files.ts
import { existsSync as existsSync20, readFileSync as readFileSync16, writeFileSync as writeFileSync3 } from "node:fs";
import { basename as basename6, join as join27, resolve as resolve5 } from "node:path";
var README_NAME = /^# \.context — (.+)$/m;
var pairOf = (set2, file2) => typeof file2 === "string" ? { set: set2, from: file2, to: file2, named: false } : { set: set2, from: file2.from, to: file2.to ?? file2.from, named: file2.named ?? false, until: file2.until };
function usedCopies(config2) {
  return config2.copies.use.flatMap((set2) => (config2.copies.sets[set2] ?? []).map((file2) => pairOf(set2, file2)));
}
function nameOf(repo, config2) {
  if (config2.name) return config2.name;
  const readme = join27(repo, ".context", "README.md");
  return existsSync20(readme) ? README_NAME.exec(readFileSync16(readme, "utf8"))?.[1]?.trim() : void 0;
}
function split(text, marker) {
  const lines = text.split("\n");
  const at = lines.findIndex((line) => line.includes(marker));
  return at === -1 ? null : { shared: lines.slice(0, at).join("\n"), own: lines.slice(at).join("\n") };
}
function compareCopies(repo, config2) {
  const { source, sets, use } = config2.copies;
  if (use.length === 0 || !source || resolve5(source) === resolve5(repo)) return [];
  if (!existsSync20(source)) return [{ pair: { set: use.join(", "), from: "", to: source, named: false }, state: "no-checkout" }];
  const unknown2 = use.filter((set2) => !sets[set2]).map((set2) => ({ pair: { set: set2, from: "", to: "", named: false }, state: "unknown-set" }));
  const productName = nameOf(repo, config2);
  const sourceName = nameOf(source, loadConfig(source).config);
  return [
    ...unknown2,
    ...usedCopies(config2).map((pair) => {
      const from = join27(source, pair.from);
      const to = join27(repo, pair.to);
      if (!existsSync20(from)) return { pair, state: "no-source" };
      if (!existsSync20(to)) return { pair, state: "missing" };
      if (pair.named && (!productName || !sourceName)) return { pair, state: "unnamed" };
      const original = pair.named ? readFileSync16(from, "utf8").replaceAll(sourceName, productName) : readFileSync16(from, "utf8");
      const current = readFileSync16(to, "utf8");
      if (!pair.until) return original === current ? { pair, state: "same" } : { pair, state: "drift", want: original };
      const theirs = split(original, pair.until);
      const ours2 = split(current, pair.until);
      if (theirs && ours2 && theirs.shared === ours2.shared) return { pair, state: "same" };
      return { pair, state: "drift", want: theirs && ours2 ? `${theirs.shared}
${ours2.own}` : void 0 };
    })
  ];
}
function syncCopies(repo, config2) {
  return compareCopies(repo, config2).flatMap(({ pair, state, want }) => {
    if (state !== "drift" || want === void 0) return [];
    writeFileSync3(join27(repo, pair.to), want);
    return [pair.to];
  });
}
var sharedFiles = {
  id: "shared-files",
  module: null,
  description: "every file of every copies set the product uses exists and matches copies.source",
  run({ repo, config: config2 }) {
    const source = config2.copies.source ? basename6(config2.copies.source) : "copies.source";
    return compareCopies(repo, config2).flatMap(({ pair, state }) => {
      const finding = (file2, message) => [{ check: "shared-files", level: "error", file: file2, message }];
      if (state === "no-checkout") return [{ check: "shared-files", level: "warn", file: CONFIG_FILE, message: `${source} is not checked out at ${pair.to}; sets ${pair.set} were not compared` }];
      if (state === "unknown-set") return finding(CONFIG_FILE, `copies.use names ${pair.set}, which no copies.sets defines`);
      if (state === "no-source") return finding(pair.to, `${source} has no ${pair.from} (set ${pair.set})`);
      if (state === "missing") return finding(pair.to, `missing \u2014 set ${pair.set} is in use; copy it from ${source}`);
      if (state === "unnamed") return finding(pair.to, "no product name to compare with \u2014 set name: in context.yaml");
      if (state === "drift") return finding(pair.to, `differs from ${source}${pair.until ? " above the shared block's end" : ""} \u2014 \`canon check --copies --sync\` copies it`);
      return [];
    });
  }
};

// cli/src/enforce/checks/refs.ts
var PATH = /(?<![\w/~.-])(\.\/)?(\.context\/[\w./@+-]*)/g;
var PLACEHOLDER2 = /[<{*[$]|YYYY|NNNN/;
var WIKILINK = /\[\[[^\]]+\]\]/g;
var CODE_SPAN = /`[^`]*`/g;
var MD_LINK = /\]\((?![a-z]+:|\/|#)([^)\s#]+\.md)(?:#[^)]*)?\)/g;
var FROM_HISTORY = /git (show|checkout|log|diff|restore)\b/;
var DATED = /(^|\/)CHANGELOG\.md$|^\.context\/ops\/incidents\//;
var BINARY = /\.(png|jpe?g|gif|webp|ico|icns|mp4|mov|pdf|zip|aab|apk|jks|keystore|p8|p12|ttf|otf|woff2?|lock|snap|sqlite|db|bin)$|(^|\/)pnpm-lock\.yaml$/i;
var STAGE_DONE = /^\s*-\s*\{[^}]*\bdone:\s*\[/;
var COPY_TO = /,\s*to:.*$/;
function git(repo, args) {
  const result = spawnSync7("git", ["-C", repo, ...args], { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
  return { status: result.status ?? 1, stdout: result.stdout ?? "" };
}
function onDisk(repo) {
  const root = join28(repo, ".context");
  if (!existsSync21(root)) return [];
  return readdirSync15(root, { recursive: true }).map((path2) => `.context/${path2}`).filter((path2) => statSync3(join28(repo, path2)).isFile());
}
function literalPart(token, restOfLine) {
  let path2 = token.replace(/[.,;:]+$/, "");
  const cut = PLACEHOLDER2.exec(path2);
  if (cut || PLACEHOLDER2.test(restOfLine.slice(0, 1))) {
    path2 = cut ? path2.slice(0, cut.index) : path2;
    path2 = path2.slice(0, path2.lastIndexOf("/") + 1);
  }
  return path2.replace(/^[./]+|[./]+$/g, "") === "context" ? null : path2;
}
var refs = {
  id: "refs",
  // A module, not always on: a repo whose docs describe other repos' .context/ (a tool, a portfolio) does not use it.
  module: "refs",
  description: "every .context/ path a tracked or local .context/ file names exists; a Markdown link names a page (a link to a page not yet written is a note); no [[slug]] links",
  run({ repo, config: config2 }) {
    const listed = git(repo, ["ls-files", "-z"]);
    if (listed.status !== 0) return [];
    const localOnly = git(repo, ["check-ignore", "-q", ".context/"]).status === 0;
    const tracked = listed.stdout.split("\0").filter(Boolean);
    const files = [.../* @__PURE__ */ new Set([...tracked, ...localOnly ? onDisk(repo) : []])].filter((file2) => !BINARY.test(file2));
    const copied = new Set(usedCopies(config2).map((pair) => pair.to));
    const exists = /* @__PURE__ */ new Map();
    const present = (path2) => {
      if (!exists.has(path2)) {
        const ignored2 = !localOnly && git(repo, ["check-ignore", "-q", path2]).status === 0;
        exists.set(path2, existsSync21(join28(repo, path2)) || ignored2);
      }
      return exists.get(path2);
    };
    const findings = [];
    for (const file2 of files) {
      if (copied.has(file2)) continue;
      let text;
      try {
        text = readFileSync17(join28(repo, file2), "utf8");
      } catch {
        continue;
      }
      const dated = DATED.test(file2);
      const links2 = file2.startsWith(".context/") && file2.endsWith(".md");
      text.split("\n").forEach((line, index) => {
        const at = `${file2}:${index + 1}`;
        const inConfig = file2 === CONFIG_FILE;
        const future = inConfig && STAGE_DONE.test(line);
        const own2 = inConfig ? line.replace(COPY_TO, "") : line;
        if (!dated && !future && own2.includes(".context/") && !FROM_HISTORY.test(own2)) {
          for (const match of own2.matchAll(PATH)) {
            let path2 = literalPart(match[2], own2.slice(match.index + match[0].length));
            if (path2 === null) continue;
            if (match[1]) path2 = normalize2(join28(dirname5(file2), path2)) + (path2.endsWith("/") ? "/" : "");
            if (!present(path2)) findings.push({ check: "refs", level: "error", file: at, message: `${path2} does not exist` });
          }
        }
        if (links2 && line.includes("](")) {
          for (const match of line.matchAll(MD_LINK)) {
            const target = normalize2(join28(dirname5(file2), match[1]));
            if (!present(target)) findings.push({ check: "refs", level: "warn", file: at, message: `${match[1]} names no page yet` });
          }
        }
        if (links2 && line.includes("[[")) {
          for (const match of line.replace(CODE_SPAN, "").matchAll(WIKILINK)) {
            findings.push({ check: "refs", level: "error", file: at, message: `${match[0]} \u2014 use a relative Markdown link, like [name](../decisions/name.md)` });
          }
        }
      });
    }
    return findings;
  }
};

// cli/src/enforce/checks/sources.ts
import { readFileSync as readFileSync18 } from "node:fs";
import { join as join29 } from "node:path";
var ACCESS = /^(mcp|skill|cli|manual):\s*(\S+)/;
var HOW_TO_QUERY = /^## How to query\s*$/m;
function accessValue(body, id) {
  const row = body.split("\n").find((line) => line.replace(/\s/g, "").startsWith(`|${id}.ACCESS|`));
  return row ? row.split("|")[2]?.trim() ?? "" : null;
}
var sources2 = {
  id: "sources",
  module: "docs",
  description: "each SOURCE.* entity page says how to read it (mcp, skill, manual, or a cli in doctor.tools) and has a How to query section",
  run({ repo, config: config2 }) {
    const tools = new Set(config2.doctor.tools.map((tool2) => tool2.tool));
