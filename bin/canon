    for (const p of prefixes) built.add(p);
  }
  const styles = read(join20(s.dir, "styles.css")).replace(/\/\*[\s\S]*?\*\//g, "");
  const own2 = new Set([...styles.matchAll(/\.([a-z][a-z0-9-]*)/g)].map((m2) => m2[1]));
  for (const c2 of sorted([...own2].filter((c3) => !used.has(c3)))) {
    if ([...built].some((p) => c2.startsWith(p))) continue;
    s.report.bad(`styles.css declares .${c2} and nothing draws it`);
  }
  const counts2 = [s.scan.pages?.length ?? 0, s.scan.links?.length ?? 0, s.scan.components?.components?.length ?? 0, s.scan.assets?.icons?.names?.length ?? 0];
  s.report.say(`   ${counts2[0]} pages, ${counts2[1]} links, ${counts2[2]} components, ${counts2[3]} icons`);
}

// cli/src/enforce/checks/design-set/index.ts
function checkSurface(repo, surface, shell) {
  const s = loadSurface(repo, surface, shell);
  for (const check2 of [inventory, wellFormed, links, tokens, clickThrough, acyclic, routes, appFlow, copy, babul]) check2(s);
  const { report } = s;
  report.say("");
  report.say(report.fail ? `${report.fail} FAILURES` : "ALL CHECKS PASS");
  return { fail: report.fail, output: report.lines.join("\n") };
}

