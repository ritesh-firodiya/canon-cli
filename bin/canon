// cli/src/work/pipeline/graph.ts
function afterOf(stages, stage2) {
  const index = stages.indexOf(stage2);
  return stage2.after ?? (index > 0 ? [stages[index - 1].id] : []);
}
function walk(start, next) {
  const seen = /* @__PURE__ */ new Set();
  let queue = [...next(start)];
  while (queue.length) {
    const [id, ...rest] = queue;
    queue = seen.has(id) ? rest : [...rest, ...next(id)];
    seen.add(id);
  }
  seen.delete(start);
  return seen;
}
function stagesBefore(stages, id) {
  return walk(id, (each) => {
    const stage2 = stages.find((entry) => entry.id === each);
    return stage2 ? afterOf(stages, stage2) : [];
  });
}
function stagesAfter(stages, id) {
  return walk(id, (each) => stages.filter((stage2) => afterOf(stages, stage2).includes(each)).map((stage2) => stage2.id));
}
function afterProblem(stages) {
  const ids = stages.map((stage2) => stage2.id);
  for (const stage2 of stages) {
    const unknown2 = (stage2.after ?? []).filter((id) => !ids.includes(id));
    if (unknown2.length) return `stage "${stage2.id}" comes after ${unknown2.join(", ")}, which is not in this pipeline`;
    if (stage2.after?.includes(stage2.id)) return `stage "${stage2.id}" cannot come after itself`;
  }
  if (!stages.length) return null;
  const reached2 = stagesAfter(stages, stages[0].id);
  const stranded = stages.slice(1).filter((stage2) => !reached2.has(stage2.id));
  return stranded.length ? `no path from "${stages[0].id}" reaches ${stranded.map((stage2) => stage2.id).join(", ")}` : null;
}

