    for (const f of readdirSync9(dir)) {
      if (f.endsWith(".tsx") && !f.startsWith("_") || isFile(join17(dir, f, "index.tsx"))) targets.add(`/(tabs)/${f.replace(/\.[^.]*$/, "")}`);
    }
  }
  return { rel: relative3(s.appDir, dir), targets };
}
function reverseFlow(s, nav, navigations) {
  const route = (r2) => appRoute(s, r2);
  const shared = sharedTargets(s, nav);
  const tab = tabs(s);
  const performed = /* @__PURE__ */ new Set();
  for (const [path2, rel] of nav.screens) {
    const froms = nav.owners.get(rel) ?? [];
    if (!froms.length) continue;
    const reach = /* @__PURE__ */ new Set([...routesIn(s, stripComments(screenSource(s, path2, nav.hooks))), ...shared]);
    if (rel.startsWith(`${tab.rel}/`)) tab.targets.forEach((t2) => reach.add(t2));
    for (const f of froms) for (const t2 of reach) performed.add(`${f}\0${route(t2)}`);
  }
  let unbuilt = 0;
  let notBuilt = 0;
  const forward = s.edges.filter((e) => !(e.back || e.side || e.state));
  for (const e of forward) {
    const from = s.files.get(e.from)?.route;
    const to = s.files.get(e.to)?.route;
    if (!from || !to || route(from) === route(to)) continue;
    if (performed.has(`${e.from}\0${route(to)}`)) continue;
    unbuilt += 1;
    const key2 = `${e.from} -> ${e.to}`;
    if (s.missing.some((m2) => m2.what === key2)) {
      notBuilt += 1;
      s.report.say(`   pending: ${key2} is drawn and the app does not go there \u2014 recorded in \`missing\``);
    } else {
      s.report.bad(`${key2} is drawn and the app never navigates there${e.label ? ` (${e.label})` : ""}`);
    }
  }
  s.report.say(`   ${navigations} navigations checked, ${forward.length - unbuilt} forward edges honoured${notBuilt ? `, ${notBuilt} recorded as departures` : ""}`);
}

