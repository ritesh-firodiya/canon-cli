function findDesigns(start) {
  for (let folder = resolve17(start); ; folder = dirname17(folder)) {
    const designs2 = join54(folder, DESIGNS2);
    if (existsSync41(join54(designs2, "design.js")) || pages(designs2).length > 0) return designs2;
    if (dirname17(folder) === folder) return null;
  }
}
function sizesOf(designs2) {
  if (!existsSync41(join54(designs2, "design.js"))) return pages(designs2);
  return JSON.parse(readFileSync39(join54(designs2, "design.js"), "utf8").replace("(window.BABUL ||= {}).product = ", "").replace(/;\s*$/, "")).sizes;
}
function plainDesignJs(designs2) {
  const product = { name: basename15(dirname17(dirname17(designs2))), sizes: pages(designs2) };
  return `(window.BABUL ||= {}).product = ${JSON.stringify(product)};`;
}
function fileFor(designs2, shell, url2) {
  const path2 = decodeURIComponent(url2.split(/[?#]/)[0]);
  if (ARCHITECTURE_PAGE.test(path2)) return join54(shell, "architecture.html");
  const [base, rest] = path2.startsWith(SERVED_SHELL) ? [shell, path2.slice(SERVED_SHELL.length)] : [designs2, path2.slice(1)];
  const file2 = resolve17(base, rest);
  if (file2 !== base && !file2.startsWith(base + sep5)) return null;
  return existsSync41(file2) && statSync8(file2).isDirectory() ? join54(file2, "index.html") : file2;
}
function registerUi(program3, env2) {
  program3.command("ui").description("serve this repo's designs on localhost: a set with the shell from this canon, or plain pages as they are").option("--port <port>", "port", "4611").action((options) => {
    const designs2 = findDesigns(process.cwd());
    if (!designs2) throw new Error(`no ${DESIGNS2} here or above holds a design.js or a folder with an index.html`);
    const loader = loaderAt(env2.canonRoot, SERVED_SHELL);
    const shell = join54(env2.canonRoot, "shell");
    const sizes = sizesOf(designs2);
    const server = createServer((request, response) => {
      const url2 = request.url ?? "/";
      if (url2 === "/") {
        response.writeHead(302, { location: `/${sizes[0]}/index.html` }).end();
        return;
      }
      if (url2.split(/[?#]/)[0] === "/shell.js") {
        response.writeHead(200, { "content-type": TYPES[".js"], "cache-control": "no-store" }).end(loader);
        return;
      }
      if (url2.split(/[?#]/)[0] === "/design.js" && !existsSync41(join54(designs2, "design.js"))) {
        response.writeHead(200, { "content-type": TYPES[".js"], "cache-control": "no-store" }).end(plainDesignJs(designs2));
        return;
      }
      if (url2.split(/[?#]/)[0] === DIAGRAMS_URL) {
        response.writeHead(200, { "content-type": TYPES[".json"], "cache-control": "no-store" }).end(architectureJson(dirname17(dirname17(designs2))));
        return;
      }
      const file2 = fileFor(designs2, shell, url2);
      if (!file2 || !existsSync41(file2)) {
        response.writeHead(404).end("not found");
        return;
      }
      response.writeHead(200, { "content-type": TYPES[extname(file2)] ?? "application/octet-stream", "cache-control": "no-store" }).end(readFileSync39(file2));
    });
    server.listen(Number(options.port), "127.0.0.1", () => {
      console.log(sizes.map((size) => `${size.padEnd(8)}http://127.0.0.1:${options.port}/${size}/index.html`).join("\n"));
    });
  });
}

// cli/src/serve/wiki/wiki.command.ts
import { spawn, spawnSync as spawnSync16 } from "node:child_process";
