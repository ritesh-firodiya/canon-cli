var SIZES = ["small", "medium", "large"];
var PRICE_FIELDS = ["input", "output", "write5m", "write1h", "cacheRead"];
var ENV_SLOTS = [
  ["ANTHROPIC_MODEL", null],
  ["ANTHROPIC_DEFAULT_HAIKU_MODEL", "small"],
  ["ANTHROPIC_DEFAULT_SONNET_MODEL", "medium"],
  ["ANTHROPIC_DEFAULT_OPUS_MODEL", "large"],
  ["ANTHROPIC_SMALL_FAST_MODEL", "small"]
];
var FAMILIES = [["haiku", "small"], ["sonnet", "medium"], ["opus", "large"]];
function checkSize(id, value) {
  if (SIZES.includes(value)) return value;
  throw new Error(`models.config.json: the size of ${id} must be one of ${SIZES.join(", ")}, not ${JSON.stringify(value)}`);
}
function checkPrice(id, value) {
  const row = value;
  if (row && PRICE_FIELDS.every((field) => typeof row[field] === "number" && Number.isFinite(row[field]))) return row;
  throw new Error(`models.config.json: the price of ${id} needs ${PRICE_FIELDS.join(", ")} as numbers (USD per million tokens)`);
}
var strings = (value) => Array.isArray(value) ? value.filter((item) => typeof item === "string" && item !== "") : typeof value === "string" && value ? [value] : [];
var mainIds = (input2) => [...input2.settings.flatMap((settings2) => strings(settings2.model)), ...strings(input2.env.ANTHROPIC_MODEL)];
function resolved(id, input2) {
  const family = FAMILIES.find(([name]) => listId(id) === name)?.[0];
  if (family) return input2.usedIds.find((used) => used.includes(`-${family}-`)) ?? id;
  if (priceOf(id, 0) || !mainIds(input2).includes(id)) return id;
  return input2.usedIds.find((used) => priceOf(used, 0)) ?? id;
}
var configPrices = (config2) => Object.fromEntries(Object.entries(config2.prices ?? {}).map(([id, price2]) => [id, checkPrice(id, price2)]));
var priceIn = (input2, id, prompt) => configPrices(input2.config)[id] ?? priceOf(resolved(id, input2), prompt);
function gatherModels(input2) {
  const configSizes = Object.fromEntries(Object.entries(input2.config.models ?? {}).map(([id, size]) => [id, checkSize(id, size)]));
  configPrices(input2.config);
  const found = [];
  const add = (id, slot, source) => {
    const known = found.find((entry) => entry.id === id);
    if (!known) found.push({ id, slot, source });
    else if (!known.slot) known.slot = slot;
  };
  for (const settings2 of input2.settings) {
    for (const id of strings(settings2.availableModels)) add(id, null, "settings availableModels");
    for (const id of strings(settings2.model)) add(id, null, "settings model");
  }
  for (const [name, slot] of ENV_SLOTS) for (const id of strings(input2.env[name])) add(id, slot, `env ${name}`);
  for (const id of input2.apiIds) add(id, null, "api");
  for (const id of input2.usedIds) add(id, null, "used");
  for (const id of Object.keys(configSizes)) add(id, null, "config");
  const isLimited = input2.settings.some((settings2) => strings(settings2.availableModels).length > 0);
  if (!isLimited) for (const [family] of FAMILIES) add(family, null, "claude code default");
  return found.map(({ id, slot, source }) => ({
    id,
    ...resolved(id, input2) === id ? {} : { runs: resolved(id, input2) },
    size: configSizes[id] ?? slot ?? FAMILIES.find(([family]) => resolved(id, input2).toLowerCase().includes(family))?.[1] ?? null,
    price: priceIn(input2, id, 0),
    source
  }));
}
