function stagePrompt(repo, config2, record2, stage2, lastStage) {
  return [
    `You are doing the "${stage2.id}" stage for ${record2.id}, in ${record2.file}. Read that page first.`,
    stage2.prompt ?? `Do the work this stage calls for and record it in the matching .context folder.`,
