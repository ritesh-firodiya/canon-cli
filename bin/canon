var RECENT_SESSIONS = 20;
var TAIL_BYTES = 256 * 1024;
var MODEL_FIELD = /"model(?:Id)?":"([^"<][^"]*)"/g;
function tail2(file2, size) {
  const length = Math.min(size, TAIL_BYTES);
  const buffer = Buffer.alloc(length);
  const fd = openSync(file2, "r");
  try {
    readSync(fd, buffer, 0, length, size - length);
  } finally {
    closeSync(fd);
  }
  return buffer.toString("utf8");
}
function usedModelIds(files = transcriptFiles()) {
  const newest = files.map((file2) => ({ file: file2, stat: statSync6(file2) })).sort((a2, b) => b.stat.mtimeMs - a2.stat.mtimeMs).slice(0, RECENT_SESSIONS);
  const ids = newest.flatMap(({ file: file2, stat }) => [...tail2(file2, stat.size).matchAll(MODEL_FIELD)].map((match) => match[1]));
  return [...new Set(ids)];
}
