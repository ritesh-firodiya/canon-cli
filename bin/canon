// cli/src/enforce/checks/diagrams.ts
import { existsSync as existsSync17, readdirSync as readdirSync13, readFileSync as readFileSync13 } from "node:fs";
import { join as join22 } from "node:path";
var FOLDER = ".context/architecture";
var FILE = `${FOLDER}/architecture.json`;
var OLD_FOLDER = ".context/wiki/concepts/architecture";
var BASES = ["measured", "stated", "code", "assumed", "unknown"];
var STALE_DAYS = 90;
var DAY_MS3 = 864e5;
function basisProblems(what, value) {
  if (!value?.basis || !BASES.includes(value.basis)) return [`${what} has no valid basis`];
  if (value.basis !== "unknown" && !value.source) return [`${what} is "${value.basis}" but names no source`];
  return [];
}
function problems(architecture2) {
  const areas = new Set((architecture2.areas ?? []).map((area) => area.id));
  const parts = architecture2.parts ?? [];
  const ids = new Set(parts.map((part) => part.id));
  return [
    ...architecture2.summary ? [] : ["no summary"],
    ...parts.flatMap((part) => [
      ...part.area && areas.has(part.area) ? [] : [`part "${part.id}" is in area "${part.area}", which does not exist`],
      ...basisProblems(`part "${part.id}" cost`, part.cost),
      // A guess must not read as a fact: "unknown" with a figure in it is the failure this page exists to stop.
      ...part.cost?.basis === "unknown" && /\d/.test(part.cost.today ?? "") ? [`part "${part.id}" cost is "unknown" but states a number: ${part.cost.today}`] : [],
      ...part.ifDown ? basisProblems(`part "${part.id}" ifDown`, part.ifDown) : []
    ]),
    ...(architecture2.flows ?? []).flatMap(
      (flow2) => (flow2.path ?? []).filter((id) => !ids.has(id)).map((id) => `flow "${flow2.name}" goes through "${id}", which is not a part`)
    )
  ];
}
function architectureJson(repo) {
  try {
    return readFileSync13(join22(repo, FILE), "utf8");
  } catch {
    return "null";
  }
}
var jsonIn = (repo, folder) => existsSync17(join22(repo, folder)) ? readdirSync13(join22(repo, folder)).filter((file2) => file2.endsWith(".json")).map((file2) => `${folder}/${file2}`) : [];
var diagrams = {
  id: "architecture-page",
  module: null,
  description: `${FILE} parses, every cost says where it came from, and its flows go through parts that exist`,
  run({ repo, today }) {
    const finding = (level, file2, message) => ({ check: "architecture-page", level, file: file2, message });
    const old = [...jsonIn(repo, OLD_FOLDER), ...jsonIn(repo, FOLDER).filter((file2) => file2 !== FILE)].map(
      (file2) => finding("warn", file2, `old diagram: the architecture is one file now, ${FILE}`)
    );
    if (!existsSync17(join22(repo, FILE))) return old;
    let architecture2;
    try {
      architecture2 = JSON.parse(readFileSync13(join22(repo, FILE), "utf8"));
    } catch (error62) {
      return [...old, finding("error", FILE, `not valid JSON: ${error62.message}`)];
    }
    const age = architecture2.verified ? (today.getTime() - new Date(architecture2.verified).getTime()) / DAY_MS3 : Infinity;
    return [
      ...old,
      ...problems(architecture2).map((message) => finding("error", FILE, message)),
      ...age > STALE_DAYS ? [finding("warn", FILE, `not verified in ${STALE_DAYS} days \u2014 check the costs and update "verified"`)] : []
    ];
  }
};

