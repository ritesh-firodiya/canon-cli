function acyclic(s) {
  s.report.head("acyclic \u2014 the forward graph ranks, so it must be a DAG");
  const forward = /* @__PURE__ */ new Map();
  for (const e of s.edges) {
    if (e.state || e.back || e.side || e.from === e.to) continue;
    forward.set(e.from, (forward.get(e.from) ?? /* @__PURE__ */ new Set()).add(e.to));
  }
  const GREY = 1;
  const BLACK = 2;
  const colour = /* @__PURE__ */ new Map();
  const cycles = [];
  const visit2 = (n3, path2) => {
    colour.set(n3, GREY);
    path2.push(n3);
    for (const m2 of sorted(forward.get(n3) ?? [])) {
      const c2 = colour.get(m2);
      if (c2 === GREY) cycles.push([...path2.slice(path2.indexOf(m2)), m2].join(" -> "));
      else if (c2 === void 0) visit2(m2, path2);
    }
    path2.pop();
    colour.set(n3, BLACK);
  };
  for (const n3 of sorted([...forward.keys(), ...[...forward.values()].flatMap((v) => [...v])])) if (!colour.has(n3)) visit2(n3, []);
  for (const c2 of cycles) s.report.bad(`forward cycle: ${c2}`);
  const edgeCount = [...forward.values()].reduce((sum, v) => sum + v.size, 0);
  s.report.say(`   ${edgeCount} forward edges over ${s.declared.size} screens, no cycles`);
}
function babul(s) {
