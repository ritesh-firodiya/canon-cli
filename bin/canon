function kindCovers(kind, wanted) {
  return kind === wanted || kind === "mobile-and-web" && (wanted === "mobile" || wanted === "web");
}

// cli/src/know/packs/packs.ts
var packSchema = external_exports.object({
  name: external_exports.string().regex(/^[a-z0-9-]+$/),
  description: external_exports.string(),
  kinds: external_exports.array(external_exports.enum(KINDS)),
  skill: external_exports.string().optional(),
  docs: external_exports.array(external_exports.url())
}).strict();
function listPacks(canonRoot) {
  const root = join2(canonRoot, "packs");
  if (!existsSync(root)) return [];
  return readdirSync(root, { withFileTypes: true }).filter((entry) => entry.isDirectory() && existsSync(join2(root, entry.name, "pack.yaml"))).map((entry) => {
    const pack = packSchema.parse((0, import_yaml.parse)(readFileSync(join2(root, entry.name, "pack.yaml"), "utf8")));
    if (pack.name !== entry.name) throw new Error(`packs/${entry.name}/pack.yaml is named "${pack.name}"`);
    return pack;
  }).sort((a2, b) => a2.name.localeCompare(b.name));
}
function findPack(canonRoot, name) {
  const packs = listPacks(canonRoot);
  const pack = packs.find((candidate) => candidate.name === name);
  if (!pack) throw new Error(`no pack "${name}" \u2014 available: ${packs.map((p) => p.name).join(", ")}`);
  return pack;
}
function addPack(repo, name, options) {
  findPack(options.canonRoot, name);
  const file2 = join2(repo, CONFIG_FILE);
  if (!existsSync(file2)) throw new Error(`${repo} has no .context/context.yaml \u2014 run \`canon init\` first`);
  const document = (0, import_yaml.parseDocument)(readFileSync(file2, "utf8"));
  const current = document.get("packs")?.toJSON() ?? [];
  if (current.includes(name)) return { file: file2, added: false };
  document.set("packs", [...current, name]);
  mkdirSync(dirname(file2), { recursive: true });
  writeFileSync(file2, document.toString());
  return { file: file2, added: true };
}
function docFileName(url2) {
  const { hostname: hostname3, pathname } = new URL(url2);
  const stem = pathname.split("/").filter(Boolean).pop()?.replace(/\.[a-z]+$/, "") ?? "index";
  return `${hostname3}-${stem}.md`;
}
async function fetchPackDocs(pack, options) {
  const dir = join2(options.cacheDir, "packs", pack.name);
  mkdirSync(dir, { recursive: true });
  for (const url2 of pack.docs) {
    let text;
    try {
      text = await options.fetchText(url2);
    } catch (error62) {
      throw new Error(`could not download ${url2}: ${error62.message}`);
    }
    writeFileSync(join2(dir, docFileName(url2)), text);
  }
  const collection = `pack-${pack.name}`;
  const added = options.run("qmd", ["collection", "add", dir, "--name", collection]);
  if (added.status === 0) {
    options.run("qmd", ["context", "add", `qmd://${collection}`, `${pack.description.split(" \u2014 ")[0]} \u2014 vendor docs index (${pack.name} pack)`]);
  } else if (/already exists/i.test(added.output)) {
    options.run("qmd", ["update"]);
  } else {
    throw new Error(`qmd could not index ${dir}: ${added.output.trim()}`);
  }
  return dir;
}

// cli/src/know/packs/add.command.ts
function registerAdd(program3, env2) {
  program3.command("add").description("add a knowledge pack (rules + vendor docs in search), e.g. canon add expo").argument("[pack]", "pack name; omit to list packs").option("--repo <repo>", "product repo", ".").action(async (name, options) => {
    if (!name) {
      for (const pack of listPacks(env2.canonRoot)) console.log(`${pack.name.padEnd(11)} ${pack.description}`);
      return;
    }
    const { file: file2, added } = addPack(resolve(options.repo), name, { canonRoot: env2.canonRoot });
    console.log(added ? `added ${name} to ${file2}` : `${name} already in ${file2}`);
    const dir = await fetchPackDocs(findPack(env2.canonRoot, name), { cacheDir: CACHE_DIR, fetchText, run: runCommand });
    console.log(`indexed ${dir} as qmd://pack-${name}`);
  });
}

