// cli/src/enforce/checks/design-set/text.ts
import { existsSync as existsSync13, readdirSync as readdirSync8, readFileSync as readFileSync11, statSync as statSync2 } from "node:fs";
import { join as join16 } from "node:path";
var read = (path2) => readFileSync11(path2, "utf8");
var isFile = (path2) => existsSync13(path2) && statSync2(path2).isFile();
var isDir = (path2) => existsSync13(path2) && statSync2(path2).isDirectory();
function walk2(dir) {
  if (!isDir(dir)) return [];
  return readdirSync8(dir, { recursive: true }).filter((path2) => !path2.split("/").some((part) => part.startsWith(".")) && isFile(join16(dir, path2))).sort();
}
var sorted = (items) => [...new Set(items)].sort();
var ENTITIES = {
  amp: "&",
  quot: '"',
  lt: "<",
  gt: ">",
  apos: "'",
  nbsp: "\xA0",
  middot: "\xB7",
  times: "\xD7",
  copy: "\xA9",
  rsquo: "\u2019",
  lsquo: "\u2018",
  rdquo: "\u201D",
  ldquo: "\u201C",
  mdash: "\u2014",
  ndash: "\u2013",
  hellip: "\u2026",
  bull: "\u2022",
  asymp: "\u2248",
  rarr: "\u2192",
  larr: "\u2190",
  deg: "\xB0",
  reg: "\xAE",
  trade: "\u2122"
};
function unescape(text) {
  return text.replace(/&(#[xX][0-9a-fA-F]+|#\d+|[a-zA-Z]+);/g, (whole, name) => {
    if (name.startsWith("#")) {
      const code = name[1] === "x" || name[1] === "X" ? parseInt(name.slice(2), 16) : parseInt(name.slice(1), 10);
      return String.fromCodePoint(code);
    }
    return ENTITIES[name] ?? whole;
  });
}
var PLAIN = [["\u2019", "'"], ["\u2018", "'"], ["\u201C", '"'], ["\u201D", '"'], ["\u2014", "-"], ["\u2013", "-"], ["\xA0", " "]];
function flat(text) {
  let out = unescape(text);
  for (const [from, to] of PLAIN) out = out.replaceAll(from, to);
  return out.replace(/\s+/g, " ").trim();
}
var HOLE = /\{!?[a-z][a-z0-9-]*(?:=[^?|}]*)?(?:\|[^}]*|\?([^:}]*)(?::([^}]*))?)?\}/g;
var unbrace = (text) => text.replace(HOLE, (_m, a2, b) => ` ${[a2, b].filter(Boolean).join(" ")} `);
function classes(text) {
  const joined = [...text.matchAll(/class="([^"]*)"/g)].map((m2) => m2[1]).join(" ");
  const words = joined.replace(/\{!?[a-z][\w-]*(?:=[^?|}]*)?\?([^:}]*)(?::([^}]*))?\}/g, (_m, a2, b) => ` ${a2} ${b ?? ""} `).split(/\s+/).filter(Boolean);
  const fixed = new Set(words.filter((w) => !w.includes("{")));
  const prefixes = new Set(words.filter((w) => w.includes("{")).map((w) => w.split("{")[0]).filter(Boolean));
  return [fixed, prefixes];
}

// cli/src/enforce/checks/design-set/app.ts
var isNextPage = (name) => /^page(\.[a-z]+)?\.tsx$/.test(name);
var isScreen = (s, name) => s.web ? isNextPage(name) : name.endsWith(".tsx") && name !== "_layout.tsx";
var recorded = (s) => s.missing.map((m2) => `${m2.what ?? ""} ${m2.why ?? ""}`).join(" ");
function routes(s) {
  s.report.head("routes \u2014 every app screen is drawn, and every drawing has a screen");
  if (!isDir(s.appDir)) {
    s.report.say(`   skipped \u2014 no app at ${s.appDir}`);
    return;
  }
  const onDisk2 = new Set(walkAll(s.appDir).filter((f) => isScreen(s, basename3(f))));
  const declared = new Set(sorted(s.declared).flatMap((f) => s.files.get(f)?.route ?? []));
  for (const r2 of sorted([...declared].filter((r3) => !onDisk2.has(r3)))) s.report.bad(`a drawing points at src/app/${r2}, which does not exist`);
  const said = recorded(s);
  const drawnRoutes = new Set([...declared].map((r2) => appRoute(s, r2)));
  for (const r2 of sorted([...onDisk2].filter((r3) => !declared.has(r3) && !drawnRoutes.has(appRoute(s, r3))))) {
    if (said.includes(r2)) s.report.say(`   pending: src/app/${r2} ships and is recorded in \`missing\``);
    else s.report.bad(`src/app/${r2} ships and no screen draws it, and \`missing\` does not say why`);
  }
  const drawn = [...s.declared].filter((f) => s.files.get(f)?.route).length;
  s.report.say(`   ${onDisk2.size} app screens, all drawn by ${drawn} wireframes`);
}
function walkAll(dir) {
  return readdirSync9(dir, { recursive: true }).filter((f) => isFile(join17(dir, f))).sort();
}
function appRoute(s, href) {
  let h2 = href.split("?")[0].replace(/^\/+|\/+$/g, "");
  h2 = `${h2}/`.replace(/\([^)/]+\)\//g, "").replace(/\/+$/, "");
  h2 = h2.replace(/\.tsx$/, "").replace(/\[[^\]/]*\]/g, "[]");
  return h2.replace(s.web ? /(^|\/)(?:index|page(?:\.[a-z]+)?)$/ : /(^|\/)index$/, "");
}
var ROUTE_LIT = String.raw`(?:["'](\/[^"'` + "`" + String.raw`$]*)|` + "`" + String.raw`(\/[^` + "`" + String.raw`]*)` + "`)";
function routeLiterals(text, before = "") {
  return new Set([...text.matchAll(new RegExp(before + ROUTE_LIT, "g"))].map((m2) => m2[1] ?? m2[2].replace(/\$\{[^}]*\}/g, "[]")));
}
function stripComments(text) {
  return text.replace(/\/\*[\s\S]*?\*\//g, "").replace(/^\s*\/\/.*$/gm, "");
}
function stripGuards(text) {
  return text.replace(/if\s*\(\s*\(?\s*![^;{]*?\)\s*\{?[^;}]*?router\.replace\([^;]*?\);/g, "");
}
function balanced(text, from) {
  let i2 = from;
  let depth = 1;
  while (i2 < text.length && depth) {
    depth += Number(text[i2] === "(") - Number(text[i2] === ")");
    i2 += 1;
  }
  return text.slice(from, i2);
}
function routesIn(s, text) {
  const out = /* @__PURE__ */ new Set();
  const add = (found) => found.forEach((r2) => out.add(r2));
  const call = s.web ? /(?:router\.(?:push|replace)|\bredirect)\(/g : /router\.(?:push|replace)\(/g;
  for (const m2 of text.matchAll(call)) add(routeLiterals(balanced(text, m2.index + m2[0].length)));
  for (const m2 of text.matchAll(/<Redirect\b[^>]*>/g)) add(routeLiterals(m2[0]));
  add(routeLiterals(text, String.raw`\b(?:href|path|to)=\{?\s*`));
  for (const name of new Set([...text.matchAll(/\b(?:href|path|to)=\{\s*([A-Za-z_]\w*)\s*\}/g)].map((m2) => m2[1]))) {
    for (const m2 of text.matchAll(new RegExp(String.raw`\bconst\s+${name}\s*=([\s\S]*?);`, "g"))) add(routeLiterals(m2[1]));
  }
  return out;
}
var importsOf = (text, prefix) => [...text.matchAll(new RegExp(String.raw`from\s+["']@/(${prefix}[^"']+)["']`, "g"))].map((m2) => m2[1]);
function hookUsers(s) {
  const users = /* @__PURE__ */ new Map();
  if (s.web) return users;
  for (const f of walk2(s.srcDir).filter((f2) => /\.ts[^/]*$/.test(basename3(f2)))) {
    for (const hook of new Set(importsOf(read(join17(s.srcDir, f)), "hooks/"))) users.set(hook, (users.get(hook) ?? 0) + 1);
  }
  return users;
}
function screenSource(s, path2, hooks) {
