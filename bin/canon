var claudeAgent = ({ prompt, tools, capUsd, cwd, small, model }) => {
  const args = ["-p", prompt, "--output-format", "json", "--max-budget-usd", String(capUsd), "--permission-mode", "acceptEdits", "--allowedTools", tools.join(","), ...small ? ["--model", "haiku"] : model ? ["--model", model] : []];
  const run2 = spawnSync12("claude", args, { cwd, encoding: "utf8", timeout: STAGE_TIMEOUT_MS, maxBuffer: 64 * 1024 * 1024, env: { ...process.env, CANON_RUN: "1" } });
  if (run2.error) return { ok: false, costUsd: 0, text: run2.error.message };
  try {
    const out = JSON.parse(run2.stdout);
    const overCap = out.subtype === "error_max_budget_usd";
    return { ok: !out.is_error && !overCap && run2.status === 0, costUsd: out.total_cost_usd ?? 0, text: out.result ?? "", overCap };
  } catch {
    return { ok: false, costUsd: 0, text: (run2.stderr || run2.stdout).slice(0, 500) };
  }
};
