// cli/src/work/run/run.command.ts
import { resolve as resolve15 } from "node:path";

// cli/src/work/run/agents.ts
import { spawnSync as spawnSync13 } from "node:child_process";
var TIMEOUT_MS = 60 * 60 * 1e3;
var MAX_BUFFER2 = 64 * 1024 * 1024;
var fill = (arg, values) => arg.replace(/\{(\w+)\}/g, (whole, key2) => values[key2] ?? whole);
function agentFor(spec) {
  if (!spec || spec === "claude") return claudeAgent;
  return ({ prompt, cwd, small, model }) => {
    const chosen = model ?? (small ? spec.smallModel : void 0);
    const values = { prompt, model: chosen ?? "" };
    const args = [...spec.args, ...chosen ? spec.modelArgs ?? [] : []].map((arg) => fill(arg, values));
    const run2 = spawnSync13(spec.command, args, { cwd, encoding: "utf8", timeout: TIMEOUT_MS, maxBuffer: MAX_BUFFER2, env: { ...process.env, CANON_RUN: "1" } });
    if (run2.error) return { ok: false, costUsd: 0, text: run2.error.message };
    return { ok: run2.status === 0, costUsd: 0, text: run2.status === 0 ? run2.stdout : (run2.stderr || run2.stdout).slice(0, 500) };
  };
}

// cli/src/work/run/trigger.ts
import { spawnSync as spawnSync14 } from "node:child_process";
var COMMAND_TIMEOUT_MS = 12e4;
var eventsSchema = external_exports.array(eventSchema);
var readEvents = async (repo, connector2) => {
  if (!connector2.target) throw new Error(`connector ${connector2.id} has no target to read from`);
  if (connector2.via === "cli" || connector2.via === "tool") {
    const run2 = spawnSync14(connector2.target, { cwd: repo, shell: true, encoding: "utf8", timeout: COMMAND_TIMEOUT_MS });
    if (run2.status !== 0) throw new Error(`connector ${connector2.id} failed: ${(run2.stderr || "no output").slice(0, 300)}`);
    return eventsSchema.parse(JSON.parse(run2.stdout));
  }
  if (connector2.via === "api") {
    const token = connector2.env?.[0] ? process.env[connector2.env[0]] : void 0;
    if (connector2.env?.[0] && !token) throw new Error(`connector ${connector2.id} needs ${connector2.env[0]} in the environment`);
    const response = await fetch(connector2.target, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
    if (!response.ok) throw new Error(`connector ${connector2.id} answered ${response.status}`);
    return eventsSchema.parse(await response.json());
  }
  throw new Error(`connector ${connector2.id} is reached over MCP, which only an agent can use. As a trigger, give it a cli or api target`);
};
async function runTrigger(repo, config2, trigger2, options) {
  const connector2 = config2.connectors.find((entry) => entry.id === trigger2.source);
  const today = (options.now ?? /* @__PURE__ */ new Date()).toISOString().slice(0, 10);
  const events = connector2 ? await (options.read ?? readEvents)(repo, connector2) : [{ id: `${trigger2.id}-${today}` }];
  const result = { trigger: trigger2.id, opened: [], joined: [], costUsd: 0, messages: [] };
  const created = events.map((event) => recordEvent(repo, config2, trigger2.source, event, { priority: trigger2.priority, pipeline: trigger2.pipeline, now: options.now }));
  for (const problem of created) (problem.isNew ? result.opened : result.joined).push(problem.id);
  if (!options.agent) return result;
  for (const id of result.opened) {
    if (trigger2.cap && result.costUsd >= trigger2.cap) {
      result.messages.push(`stopped at the $${trigger2.cap} cap: ${id} and later problems wait`);
      break;
    }
    const run2 = runRecord(repo, config2, id, options.agent);
    result.costUsd += run2.costUsd;
    result.messages.push(`${id}: ${run2.message}`);
  }
  return result;
}

// cli/src/work/run/run.command.ts
var collect2 = (value, list) => [...list, value];
function registerRun(program3) {
  program3.command("run").description("move a record through its pipeline with an agent, stopping at each gate and cap").argument("<record>", "the record, like PROB-0001").argument("[repo]", "product repo", ".").option("--with <stage>", "run this optional stage without asking; repeat for each", collect2, []).option("--skip <stage>", "skip this optional stage without asking; repeat for each", collect2, []).option("--unverified <reason>", "a person's reason to go ahead when a source could not be checked").action((recordId, repo, options) => {
    if (process.env.CANON_RUN) throw new Error("canon run cannot start from inside a run");
    const root = resolve15(repo);
    const result = runRecord(root, loadConfig(root).config, recordId, agentFor(loadConfig(root).config.agent), options);
    console.log(`${result.status}: ${result.message} ($${result.costUsd.toFixed(2)} this run)`);
    if (result.status === "stopped") process.exitCode = 1;
  });
  program3.command("trigger").description("read each trigger's source and open problems, joining repeats to the open one. Schedule it with launchd or cron").argument("[id]", "one trigger; all of them when left out").argument("[repo]", "product repo", ".").option("--run", "also run the new problems, up to each trigger's cap").action(async (id, repo, options) => {
    const root = resolve15(repo);
    const { config: config2 } = loadConfig(root);
    const triggers = id ? config2.triggers.filter((entry) => entry.id === id) : config2.triggers;
    if (triggers.length === 0) throw new Error(id ? `no trigger ${id}` : "no triggers: in context.yaml");
    for (const trigger2 of triggers) {
      const result = await runTrigger(root, config2, trigger2, { agent: options.run ? agentFor(config2.agent) : void 0 });
      console.log(`${trigger2.id}: ${result.opened.length} opened, ${result.joined.length} joined`);
      for (const message of result.messages) console.log(`  ${message}`);
    }
  });
}

