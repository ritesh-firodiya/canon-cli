// cli/src/serve/wiki/wiki.ts
var import_yaml8 = __toESM(require_dist(), 1);
import { existsSync as existsSync42, mkdirSync as mkdirSync14, rmSync as rmSync3, symlinkSync as symlinkSync2, writeFileSync as writeFileSync14 } from "node:fs";
import { basename as basename16, join as join55 } from "node:path";
function relink(target, link) {
  rmSync3(link, { force: true, recursive: false });
  symlinkSync2(target, link);
}
function buildSite(products, options) {
  mkdirSync14(options.siteDir, { recursive: true });
  const rows2 = [];
  for (const product of products) {
    const name = basename16(product);
    const wiki = join55(product, ".context", "wiki");
    const links2 = [];
    if (existsSync42(wiki)) {
      relink(wiki, join55(options.siteDir, name));
      links2.push(`[${name}](${name}/index.md)`);
    }
    const graph = options.graph?.(product);
    if (graph) {
      mkdirSync14(join55(options.siteDir, "architecture"), { recursive: true });
      writeFileSync14(
        join55(options.siteDir, "architecture", `${name}.md`),
        `---
title: ${name} architecture
---

Imports between parts of ${name}, from its \`.dependency-cruiser.cjs\`. Broken rules fail \`canon check\`.

${graph}
`
      );
      links2.push(`[architecture graph](architecture/${name}.md)`);
    }
    if (links2.length > 0) rows2.push(`- ${links2.join(" \xB7 ")}`);
  }
  writeFileSync14(
    join55(options.siteDir, "index.md"),
    `---
title: canon
---

Every product's wiki, searchable and linked; products with architecture rules also get an import graph.

${rows2.join("\n")}
`
  );
}
var IGNORED = ["**/CLAUDE.md"];
function quartzConfig(defaultsYaml) {
  const document = (0, import_yaml8.parseDocument)(defaultsYaml);
  document.setIn(["configuration", "pageTitle"], "canon");
  document.setIn(["configuration", "analytics"], null);
  document.setIn(["configuration", "baseUrl"], "localhost");
  const current = document.getIn(["configuration", "ignorePatterns"])?.toJSON() ?? [];
  document.setIn(["configuration", "ignorePatterns"], [...current, ...IGNORED.filter((p) => !current.includes(p))]);
  const plugins = document.get("plugins");
  plugins?.items.find((plugin) => plugin.get("source") === "@quartz-community/og-image")?.set("enabled", false);
  plugins?.items.find((plugin) => plugin.get("source") === "@quartz-community/crawl-links")?.setIn(["options", "markdownLinkResolution"], "relative");
  return document.toString();
}

// cli/src/serve/wiki/wiki.command.ts
var QUARTZ_REPO = "https://github.com/jackyzha0/quartz";
var QUARTZ_COMMIT = "97a2d05f80c4c50534959b1d0d41cc4b3895625e";
var QUARTZ_DIR = join56(CACHE_DIR, "quartz");
function must(command2, args, cwd) {
  const result = spawnSync16(command2, args, { cwd, stdio: "inherit" });
  if (result.status !== 0) throw new Error(`${command2} ${args.join(" ")} failed`);
}
function ensureQuartz() {
  if (!existsSync43(join56(QUARTZ_DIR, "node_modules"))) {
    if (!existsSync43(QUARTZ_DIR)) must("git", ["clone", "--quiet", "--filter=blob:none", QUARTZ_REPO, QUARTZ_DIR]);
    must("git", ["checkout", "--quiet", QUARTZ_COMMIT], QUARTZ_DIR);
    must("npm", ["ci", "--silent"], QUARTZ_DIR);
  }
  const defaults = readFileSync40(join56(QUARTZ_DIR, "quartz.config.default.yaml"), "utf8");
  writeFileSync15(join56(QUARTZ_DIR, "quartz.config.yaml"), quartzConfig(defaults));
}
function registerWiki(program3, env2) {
  program3.command("wiki").description("serve every product wiki (search, backlinks, graph) on localhost").option("--port <port>", "wiki site port", "4610").option("--ws-port <port>", "live-reload socket port", "4612").action((options) => {
    ensureQuartz();
    const products = findProducts(requireWorkspace(env2));
    const siteDir = join56(CACHE_DIR, "site");
    buildSite(products, { siteDir, graph: architectureGraph });
    const site = spawn("npx", ["quartz", "build", "-d", siteDir, "-o", join56(CACHE_DIR, "public"), "--serve", "--port", options.port, "--wsPort", options.wsPort], {
      cwd: QUARTZ_DIR,
      stdio: "inherit"
    });
    console.log(`wiki    http://localhost:${options.port}`);
    process.on("SIGINT", () => site.kill());
    site.on("exit", (code) => {
      process.exitCode = code ?? 0;
    });
  });
}

