// cli/src/enforce/checks/standards-copies.ts
import { existsSync as existsSync11, readdirSync as readdirSync7, readFileSync as readFileSync10 } from "node:fs";
import { join as join14 } from "node:path";
var COPY_THRESHOLD = 0.6;
var STANDARD_COPIES = [{ file: ".context/wiki/CLAUDE.md", standard: "standards/writing.md" }];
function meaningfulLines(text) {
  return new Set(
    text.split("\n").map((line) => line.trim()).filter((line) => line.length > 0 && !line.startsWith("<!--"))
  );
}
function sharedFraction(standard, candidate) {
  const wanted = meaningfulLines(standard);
  const present = meaningfulLines(candidate);
  const shared = [...wanted].filter((line) => present.has(line)).length;
  return wanted.size === 0 ? 0 : shared / wanted.size;
}
var standardsCopies = {
  id: "standards-copies",
  module: null,
  description: "shared rules and skills come from canon, not from a copy in the product",
  run({ repo, canonRoot }) {
    const findings = [];
    for (const { file: file2, standard } of STANDARD_COPIES) {
      const productFile = join14(repo, file2);
      const standardFile = join14(canonRoot, standard);
      if (!existsSync11(productFile) || !existsSync11(standardFile)) continue;
      const fraction = sharedFraction(readFileSync10(standardFile, "utf8"), readFileSync10(productFile, "utf8"));
      if (fraction >= COPY_THRESHOLD) {
        findings.push({
          check: "standards-copies",
          level: "warn",
          file: file2,
          message: `${Math.round(fraction * 100)}% copy of canon ${standard} \u2014 replace with a pointer`
        });
      }
    }
    const plugins = join14(canonRoot, "plugins");
    const productSkills = join14(repo, ".claude", "skills");
    if (existsSync11(plugins) && existsSync11(productSkills)) {
      const provided = new Map(
        readdirSync7(plugins).flatMap((plugin) => {
          const skills = join14(plugins, plugin, "skills");
          return existsSync11(skills) ? readdirSync7(skills).map((skill) => [skill, plugin]) : [];
        })
      );
      for (const skill of readdirSync7(productSkills)) {
        const plugin = provided.get(skill);
        if (!plugin) continue;
        findings.push({
          check: "standards-copies",
          level: "warn",
          file: `.claude/skills/${skill}`,
          message: `canon provides this as ${plugin}:${skill} \u2014 delete the product copy`
        });
      }
    }
    return findings;
  }
};

