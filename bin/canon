// cli/src/enforce/checks/architecture.ts
import { spawnSync as spawnSync3 } from "node:child_process";
import { existsSync as existsSync7, readdirSync as readdirSync5 } from "node:fs";
import { createRequire } from "node:module";
import { join as join9, posix } from "node:path";
var RULES_FILES = [".dependency-cruiser.cjs", ".dependency-cruiser.js", ".dependency-cruiser.mjs", ".dependency-cruiser.json"];
var DEFAULT_COLLAPSE = "^(apps|packages)/[^/]+|^[^/]+/[^/]+";
var SHOWN_PER_RULE = 3;
var MERMAID_MAX_CHARS = 5e4;
var MAX_BUFFER = 64 * 1024 * 1024;
var WORKSPACE_PARENTS = ["apps", "packages"];
function rulesFile(dir) {
  return RULES_FILES.find((file2) => existsSync7(join9(dir, file2)));
}
function findRules(repo) {
  const workspaces = WORKSPACE_PARENTS.flatMap(
    (parent) => existsSync7(join9(repo, parent)) ? readdirSync5(join9(repo, parent), { withFileTypes: true }).filter((entry) => entry.isDirectory()).map((entry) => `${parent}/${entry.name}`).sort() : []
  );
  return [".", ...workspaces].flatMap((dir) => {
    const file2 = rulesFile(join9(repo, dir));
    return file2 ? [{ dir, file: file2 }] : [];
  });
}
var fromRoot = (dir, path2) => posix.normalize(posix.join(dir, path2));
function ignoredBy(repo, paths) {
  if (paths.length === 0) return /* @__PURE__ */ new Set();
  const result = spawnSync3("git", ["-C", repo, "check-ignore", "--stdin"], { input: paths.join("\n"), encoding: "utf8" });
  return new Set(result.stdout.split("\n").filter(Boolean));
}
function depcruiseBin(repo) {
  const bin = join9(repo, "node_modules", ".bin", "depcruise");
  return existsSync7(bin) ? bin : void 0;
}
function depcruise(repo, bin, rules, args) {
  return spawnSync3(bin, [".", "--config", rules.file, ...args], { cwd: join9(repo, rules.dir), encoding: "utf8", maxBuffer: MAX_BUFFER });
}
function unreadTypeScript(repo, rules, modules) {
  return existsSync7(join9(repo, rules.dir, "tsconfig.json")) && !modules.some((m2) => /\.tsx?$/.test(m2.source));
}
function typeScriptWarning(rules) {
  const file2 = fromRoot(rules.dir, "tsconfig.json");
  const message = "no TypeScript files were read, so their imports went unchecked \u2014 dependency-cruiser needs `typescript` below 7 installed here";
  return [{ check: "architecture", level: "warn", file: file2, message }];
}
function summarize(violations) {
  const byRule = /* @__PURE__ */ new Map();
  for (const violation of violations.filter((v) => v.rule.severity === "error" || v.rule.severity === "warn")) {
    byRule.set(violation.rule.name, [...byRule.get(violation.rule.name) ?? [], violation]);
  }
  return [...byRule].map(([name, list]) => {
    const shown = list.slice(0, SHOWN_PER_RULE).map((v) => v.from === v.to ? v.from : `${v.from} \u2192 ${v.to}`);
    const more = list.length > SHOWN_PER_RULE ? ` and ${list.length - SHOWN_PER_RULE} more` : "";
    return {
      check: "architecture",
      level: list[0].rule.severity === "error" ? "error" : "warn",
      file: list[0].from,
      message: `${name} (${list.length}): ${shown.join(", ")}${more}`
    };
  });
}
var architecture = {
  id: "architecture",
  module: "architecture",
  description: "the repo keeps the import boundaries in its own .dependency-cruiser.cjs",
  run({ repo }) {
    const finding = (message, file2) => [{ check: "architecture", level: "error", file: file2, message }];
    const all = findRules(repo);
    if (all.length === 0) {
      return finding("no architecture rules \u2014 run `canon init --force --modules ...,architecture` for a starter, or write one", RULES_FILES[0]);
    }
    const bin = depcruiseBin(repo);
    if (!bin) return finding("dependency-cruiser is not installed here \u2014 add it as a devDependency (e.g. `pnpm add -D dependency-cruiser`)", "package.json");
    return all.flatMap((rules) => {
      const result = depcruise(repo, bin, rules, ["--output-type", "json"]);
      try {
        const cruise = JSON.parse(result.stdout);
        const violations = cruise.summary.violations.map((v) => ({ ...v, from: fromRoot(rules.dir, v.from), to: fromRoot(rules.dir, v.to) }));
        const ignored2 = ignoredBy(repo, violations.map((v) => v.from));
        const findings = summarize(violations.filter((v) => !ignored2.has(v.from)));
        return unreadTypeScript(repo, rules, cruise.modules) ? [...findings, ...typeScriptWarning(rules)] : findings;
      } catch {
        const why = (result.error?.message ?? result.stderr).trim().split("\n").slice(-5).join(" ");
        return finding(`dependency-cruiser failed: ${why}`, fromRoot(rules.dir, rules.file));
      }
    });
  }
};
function collapsePattern(dir, file2) {
  try {
    const config2 = createRequire(join9(dir, "noop.js"))(join9(dir, file2));
    return config2.options?.reporterOptions?.archi?.collapsePattern ?? DEFAULT_COLLAPSE;
  } catch {
    return DEFAULT_COLLAPSE;
  }
}
function graphOf(repo, bin, rules) {
  const collapse = collapsePattern(join9(repo, rules.dir), rules.file);
  const ownCode = "^(?!(\\.\\./)*node_modules/)";
  const result = depcruise(repo, bin, rules, ["--output-type", "mermaid", "--collapse", collapse, "--include-only", ownCode]);
  if (result.status !== 0 || !result.stdout.trim()) return void 0;
  if (result.stdout.length > MERMAID_MAX_CHARS) {
    return 'flowchart LR\n  too_big["Graph too large to draw \u2014 set a coarser reporterOptions.archi.collapsePattern"]';
  }
  return result.stdout.trim();
}
function architectureGraph(repo) {
  const bin = depcruiseBin(repo);
  if (!bin) return void 0;
  const sections = findRules(repo).flatMap((rules) => {
    const graph = graphOf(repo, bin, rules);
    return graph ? [`## ${rules.dir === "." ? "Whole repo" : rules.dir}

\`\`\`mermaid
${graph}
\`\`\``] : [];
  });
  return sections.length > 0 ? sections.join("\n\n") : void 0;
}

// cli/src/enforce/checks/canonical-values.ts
import { readFileSync as readFileSync6 } from "node:fs";
import { join as join10 } from "node:path";
var PRICE = /(?:[$₹€£]\s?\d[\d,]*(?:\.\d+)?)/g;
var CODE_BLOCK3 = /```[\s\S]*?```/g;
var PRICE_WORDS = /pric|cost|paywall|plan|tier|subscri|bundle|pack|purchase|buy|unlock|\/mo|per month|per year|annual|yearly|monthly/i;
function amounts(text) {
  return (text.match(PRICE) ?? []).map((price2) => price2.replace(/\s/g, ""));
}
var REJECTED = /^\*\*Rejected:\*\*/;
function pricesIn(text) {
  const paragraphs = text.replace(CODE_BLOCK3, "").split(/\n\s*\n/).filter((paragraph) => !REJECTED.test(paragraph.trim()));
  return [...new Set(paragraphs.filter((paragraph) => PRICE_WORDS.test(paragraph)).flatMap(amounts))];
}
function heldAmounts(text) {
  return amounts(text.replace(CODE_BLOCK3, ""));
}
var folderOf = (file2) => file2.split("/")[2];
var canonicalValues = {
  id: "canonical-values",
  module: "docs",
  description: "a price stated in a decision or screen note is held by an entity page \u2014 one home per fact (C-02)",
  run({ repo }) {
    const pages2 = wikiPages(repo).map((file2) => ({ file: file2, ...parseFrontmatter(readFileSync6(join10(repo, file2), "utf8")) }));
    const held = new Set(pages2.filter((page) => folderOf(page.file) === "entities").flatMap((page) => heldAmounts(page.body)));
    return pages2.filter((page) => ["decisions", "surfaces"].includes(folderOf(page.file))).flatMap((page) => {
      const orphans = pricesIn(page.body).filter((price2) => !held.has(price2));
      if (orphans.length === 0) return [];
      return [
        {
          check: "canonical-values",
          level: "warn",
          file: page.file,
          message: `${orphans.join(", ")} stated here but held by no entity page`
        }
      ];
    });
  }
};

// cli/src/enforce/checks/context-layout.ts
import { spawnSync as spawnSync4 } from "node:child_process";
import { existsSync as existsSync8, readdirSync as readdirSync6, readFileSync as readFileSync7 } from "node:fs";
import { basename, join as join11, relative as relative2 } from "node:path";
function requiredContext(modules, records2 = DEFAULT_RECORDS, kind) {
  const knowledge = modules.includes("docs") || modules.includes("knowledge");
  const features = kind !== "content" && records2.some((record2) => record2.folder === "features") ? ["features"] : [];
  return ["README.md", "tasks.md", ...knowledge ? ["raw", "wiki", ...features] : []];
}
var START_MINIMUM = [
  ["wiki/concepts/purpose.md", "what the product is, who it is for and what it is not", true],
  ["wiki/concepts/glossary.md", "the product's and the domain's words", false],
  ["wiki/decisions", "what was chosen and what was rejected", true],
  ["architecture/architecture.json", "how it is built and what it costs", false],
  ["ops/run.md", "how to run, test and release it", false]
];
var ROOT_FILES = ["README.md", "tasks.md", basename(CONFIG_FILE), basename(LOCAL_CONFIG_FILE)];
var LIVE_FOLDERS = ["marketing", "metrics", "support", "legal"];
var ROOT_STRAYS = ["TODO.md", "STATUS.md", "SETUP.md"];
function emptyFolders(dir) {
  const entries = readdirSync6(dir, { withFileTypes: true });
  if (entries.length === 0) return [dir];
  return entries.filter((entry) => entry.isDirectory()).flatMap((entry) => emptyFolders(join11(dir, entry.name)));
}
function ignored(repo, path2) {
  return spawnSync4("git", ["-C", repo, "check-ignore", "-q", path2]).status === 0;
}
var contextLayout = {
  id: "context-layout",
  module: null,
  description: ".context/ has the required folders, only the allowed ones (the built-in folders, the repo's records and context.folders), and only README.md, tasks.md and the config at its root",
  run({ repo, config: config2 }) {
    const context = join11(repo, ".context");
    const finding = (level, file2, message) => ({
      check: "context-layout",
      level,
      file: file2,
      message
    });
    if (!existsSync8(context)) return [finding("error", ".context", "no .context/ folder \u2014 run `canon init`")];
    const required2 = requiredContext(config2.modules, config2.records, config2.kind);
    const findings = required2.filter((name) => !existsSync8(join11(context, name))).map(
      (name) => finding("error", `.context/${name}`, `required ${name} is missing`)
    );
    if (required2.includes("wiki")) {
      for (const [page, answers, everyKind] of START_MINIMUM) {
        if ((everyKind || config2.kind !== "content") && !existsSync8(join11(context, page))) findings.push(finding("warn", `.context/${page}`, `start minimum: no page says ${answers}`));
      }
    }
    const allowed = [...CONTEXT_FOLDERS, ...config2.records.map((kind) => kind.folder), ...config2.context.folders.map((entry) => entry.folder)];
    for (const entry of readdirSync6(context, { withFileTypes: true })) {
      if (entry.name === ".DS_Store") continue;
      if (entry.isDirectory() && !allowed.includes(entry.name)) {
        findings.push(finding("error", `.context/${entry.name}`, `${entry.name}/ is not an allowed folder \u2014 move it, or add it under context.folders in context.yaml`));
      }
      if (entry.isFile() && !ROOT_FILES.includes(entry.name)) {
        findings.push(finding("error", `.context/${entry.name}`, "only README.md, tasks.md, context.yaml and context.local.yaml may sit at .context/ root"));
      }
    }
    if (existsSync8(join11(context, "raw")) && !existsSync8(join11(context, "raw", ".gitkeep"))) {
      findings.push(finding("warn", ".context/raw/.gitkeep", "raw/ needs its .gitkeep so it survives a clean clone"));
    }
    for (const empty of emptyFolders(context)) {
      if (empty !== join11(context, "raw") && !ignored(repo, empty)) {
        findings.push(finding("error", relative2(repo, empty), "empty folder \u2014 git will drop it"));
      }
    }
    const release = join11(context, "ops", "release.yml");
    if (existsSync8(release) && /^\s+live:(?!\s*null)/m.test(readFileSync7(release, "utf8"))) {
      for (const owed of LIVE_FOLDERS) {
        if (!existsSync8(join11(context, owed))) findings.push(finding("error", `.context/${owed}`, `live (ops/release.yml) but no ${owed}/`));
      }
    }
    for (const stray of ROOT_STRAYS) {
      if (existsSync8(join11(repo, stray))) findings.push(finding("error", stray, "nothing renders it at the root \u2014 it belongs in .context/ (tasks.md, ops/)"));
    }
    if (existsSync8(join11(repo, "docs")) && !config2.context.rootFolders.some((entry) => entry.folder === "docs")) {
      findings.push(finding("error", "docs/", "a root docs/ folder \u2014 that material belongs in .context/, or name it under context.rootFolders in context.yaml"));
    }
    if (existsSync8(join11(repo, "store.config.json")) && existsSync8(join11(context, "listing", "ios"))) {
      findings.push(finding("error", "store.config.json", "two Apple listings \u2014 .context/listing/ios/ is the one source"));
    }
    const agents = join11(repo, "AGENTS.md");
    if (existsSync8(agents) && !ignored(repo, context) && !readFileSync7(agents, "utf8").includes("tasks.md")) {
      findings.push(finding("error", "AGENTS.md", "does not point at .context/tasks.md"));
    }
    return findings;
  }
};

// cli/src/enforce/checks/context-size.ts
import { existsSync as existsSync9, readFileSync as readFileSync8 } from "node:fs";
import { basename as basename2, join as join12 } from "node:path";
var MAX_LINES = { page: 60, decision: 30, readme: 30, tasks: 100 };
var DATED_NAME = /^\d{4}-\d{2}-\d{2}-/;
var lineCount = (repo, file2) => readFileSync8(join12(repo, file2), "utf8").trimEnd().split("\n").length;
var contextSize = {
  id: "context-size",
  module: "docs",
  description: "pages, decisions, README.md and tasks.md stay under their line caps; decisions are one file per topic",
  run({ repo }) {
    const findings = [];
    const warn = (file2, message) => findings.push({ check: "context-size", level: "warn", file: file2, message });
    const overCap = (file2, cap) => {
      const lines = lineCount(repo, file2);
      if (lines > cap) warn(file2, `${lines} lines, cap ${cap} \u2014 cut what code, designs or git already say`);
    };
    for (const file2 of wikiPages(repo)) {
      const folder = file2.split("/")[2];
      if (folder === "synthesis") continue;
      if (folder === "decisions" && DATED_NAME.test(basename2(file2))) {
        warn(file2, "name a decision by topic and edit it in place \u2014 git keeps the history");
      }
      overCap(file2, folder === "decisions" ? MAX_LINES.decision : MAX_LINES.page);
    }
    const readme = ".context/README.md";
    const tasks2 = ".context/tasks.md";
    if (existsSync9(join12(repo, readme))) overCap(readme, MAX_LINES.readme);
    if (existsSync9(join12(repo, tasks2))) {
      overCap(tasks2, MAX_LINES.tasks);
      if (/^## (Done|Session Notes)\b/m.test(readFileSync8(join12(repo, tasks2), "utf8"))) {
        warn(tasks2, "tasks.md holds only open work \u2014 delete done tasks and session notes; the commits record them");
      }
    }
    return findings;
  }
};

