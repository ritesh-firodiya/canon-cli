    message: "Which modules? All optional. (docs = wiki, design = HTML designs, knowledge = search, metrics = definitions.yml, code = LSP, architecture, listing)",
    initialValues: inferred.config.modules,
    options: MODULES.map((value) => ({ value, label: value })),
    required: false
  });
  if (cancelled(modules)) return null;
  const forKind = packs.filter((pack) => pack.kinds.some((wanted) => kindCovers(kind, wanted)));
  if (forKind.length === 0) return { kind, modules, packs: [] };
  const chosen = await multiselect({
    message: "Which vendor doc packs? (indexed for search on `canon update --refresh`)",
    initialValues: inferred.config.packs ?? [],
    options: forKind.map((pack) => ({ value: pack.name, label: pack.name, hint: pack.description })),
    required: false
  });
  if (cancelled(chosen)) return null;
  return { kind, modules, packs: chosen };
}
function registerInit(program3, env2) {
  program3.command("init").description("set canon up for a product: write .context/context.yaml and the missing .context files").argument("[repo]", "product repo", ".").option("-y, --yes", "accept what canon infers (and any flags below), no questions").addOption(new Option("--kind <kind>", "product kind").choices(KINDS)).option("--modules <list>", `comma list, empty for none: ${MODULES.join(", ")}`).option("--packs <list>", "comma list of vendor doc packs (see `canon add`)").option("--force", "redo a repo that already has context.yaml").action(async (repo, options) => {
    const path2 = resolve10(repo);
    const packs = listPacks(env2.canonRoot);
    const flags = {
      canonVersion: canonVersion(env2.canonRoot),
      force: options.force,
      kind: options.kind,
      modules: options.modules === void 0 ? void 0 : parseChoices(options.modules, MODULES, "module"),
      packs: options.packs === void 0 ? void 0 : parseChoices(options.packs, packs.map((p) => p.name), "pack")
    };
    const inferred = planInit(path2, flags);
    const answers = options.yes ? null : await askAnswers(inferred, packs);
    if (!options.yes && answers === null) return;
    const plan = answers ? planInit(path2, { ...flags, ...answers }) : inferred;
    applyInit(path2, plan, { name: basename8(path2), canonRoot: env2.canonRoot, run: (command2, args) => void runCommand(command2, args) });
    console.log(`wrote .context/context.yaml (${plan.config.kind}: ${plan.config.modules.join(", ")})`);
    for (const file2 of plan.create) console.log(`created ${file2}`);
    if (plan.create.some((file2) => file2.endsWith(RULES_FILES[0]))) console.log("architecture: add the checker with `pnpm add -D dependency-cruiser`, then edit the .dependency-cruiser.cjs files to this repo's layers");
    console.log(formatModels(await writeModels()));
    console.log(plan.config.packs ? "next: canon update --refresh (fetches the packs), then canon check" : "next: canon check");
  });
}

