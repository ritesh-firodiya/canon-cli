// cli/src/work/records/new.ts
var TEMPLATES = join45(CANON_ROOT, "templates", "records");
var FRONTMATTER3 = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/;
var WIKI_DOCS = { discovery: "wiki/synthesis", finding: "wiki/synthesis", decision: "wiki/decisions", fact: "raw" };
function splitTemplate(text, title, today) {
  const filled = text.replaceAll("{{title}}", title.replace(/\s+/g, " ")).replaceAll("{{today}}", today);
  const match = FRONTMATTER3.exec(filled);
  return match ? { fields: (0, import_yaml7.parse)(match[1]) ?? {}, body: filled.slice(match[0].length) } : { fields: {}, body: filled };
}
function generatedTemplate(kind, title, today) {
  const listed = Object.fromEntries(Object.entries(kind.fields).flatMap(([field, rule]) => Array.isArray(rule) ? [[field, rule[0]]] : []));
  return { fields: { status: kind.statuses[0], ...listed, "last-verified": today }, body: [`# ${title}`, ...kind.sections.map((section2) => `
## ${section2}`)].join("\n") };
}
function templateFile(repo, name) {
  const own2 = join45(repo, ".context", "templates", `${name}.md`);
  return existsSync35(own2) ? own2 : join45(TEMPLATES, `${name}.md`);
}
function recordTemplate(repo, kind, title, today) {
  const file2 = templateFile(repo, kind.folder);
  return existsSync35(file2) ? splitTemplate(readFileSync33(file2, "utf8"), title, today) : generatedTemplate(kind, title, today);
}
function newPage(repo, config2, what, title, fields = {}, now = /* @__PURE__ */ new Date()) {
  const today = now.toLocaleDateString("sv-SE");
  const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48) || "page";
  const wikiFolder = WIKI_DOCS[what];
  if (wikiFolder) {
    const file2 = join45(".context", wikiFolder, `${wikiFolder === "raw" ? `${today}-` : ""}${slug}.md`);
    if (existsSync35(join45(repo, file2))) throw new Error(`${file2} already exists: one page per topic, so edit it`);
    mkdirSync10(dirname14(join45(repo, file2)), { recursive: true });
    const text = readFileSync33(templateFile(repo, what), "utf8").replaceAll("{{title}}", title.replace(/\s+/g, " ")).replaceAll("{{today}}", today);
    writeFileSync10(join45(repo, file2), text);
    return { id: slug, file: file2 };
  }
  const kind = config2.records.find((entry) => entry.folder === what || entry.folder === `${what}s`);
  if (!kind) throw new Error(`no kind "${what}" \u2014 kinds here: ${[...config2.records.map((entry) => entry.folder), ...Object.keys(WIKI_DOCS)].join(", ")}`);
  const template2 = recordTemplate(repo, kind, title, today);
  const merged = { ...template2.fields, ...config2.owner ? { owner: config2.owner } : {}, ...fields };
  if (merged.priority && !fields.priority && !(String(merged.priority) in config2.priorities)) merged.priority = Object.keys(config2.priorities).at(-1);
  for (const field of kind.removed) delete merged[field];
  const missing = kind.required.filter((field) => !field.startsWith("## ") && !merged[field]);
  if (missing.length) throw new Error(`${kind.folder} needs ${missing.map((field) => `--set ${field}=...`).join(" ")}`);
  for (const [field, value] of Object.entries(fields)) {
    const problem = fieldProblem(config2, kind, field, value);
    if (problem) throw new Error(problem);
  }
  return createRecord(repo, kind, title, merged, template2.body);
}

