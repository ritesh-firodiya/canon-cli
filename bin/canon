// cli/src/know/sync/sync.ts
import { existsSync as existsSync38, readFileSync as readFileSync37, writeFileSync as writeFileSync13 } from "node:fs";
import { basename as basename14, join as join50 } from "node:path";
function withVersion(text, version2) {
  const line = `canon: ${version2}`;
  return /^canon:.*$/m.test(text) ? text.replace(/^canon:.*$/m, line) : `${text.replace(/\n?$/, "\n")}${line}
`;
}
async function syncRepo(repo, options) {
  const file2 = join50(repo, CONFIG_FILE);
  if (!existsSync38(file2)) throw new Error(`${repo} has no .context/context.yaml \u2014 run \`canon init\` first`);
  const { config: config2 } = loadConfig(repo);
  const packs = config2.packs;
  for (const name of packs) {
    await fetchPackDocs(findPack(options.canonRoot, name), options);
  }
  if (config2.modules.includes("knowledge")) indexKnowledge(repo, basename14(repo), options.run);
  options.run("qmd", ["update"]);
  options.run("qmd", ["embed"]);
  const base = refreshArchitectureBase(repo, options.canonRoot);
  const current = canonVersion(options.canonRoot);
  if (config2.canon === current) return { packs, base, version: null };
  writeFileSync13(file2, withVersion(readFileSync37(file2, "utf8"), current));
  return { packs, base, version: { from: config2.canon, to: current } };
}

// cli/src/setup/update/update.ts
import { existsSync as existsSync39 } from "node:fs";
import { join as join51, sep as sep4 } from "node:path";
var PACKAGE = "@freetesh/canon";
var PLUGIN = "canon@canon";
var MARKETPLACE = "canon";
function isOlder(a2, b) {
  const [x, y2] = [a2, b].map((v) => v.split(".").map(Number));
  for (let i2 = 0; i2 < 3; i2 += 1) if ((x[i2] ?? 0) !== (y2[i2] ?? 0)) return (x[i2] ?? 0) < (y2[i2] ?? 0);
  return false;
}
async function updateCanon(options) {
  const { canonRoot, run: run2 } = options;
  const current = canonVersion(canonRoot);
  const latest = JSON.parse(await options.fetchText(`https://registry.npmjs.org/${PACKAGE}/latest`)).version;
  const lines = [];
  if (existsSync39(join51(canonRoot, ".git"))) {
    lines.push(`cli: running from a checkout at ${canonRoot} (${current}, latest ${latest}) \u2014 git pull there`);
  } else if (!isOlder(current, latest)) {
    lines.push(`cli: already the latest (${current})`);
  } else {
    const [manager, ...args] = canonRoot.split(sep4).includes("pnpm") ? ["pnpm", "add", "-g"] : ["npm", "install", "-g"];
    const result = run2(manager, [...args, `${PACKAGE}@${latest}`]);
    if (result.status !== 0) throw new Error(`${manager} could not install ${PACKAGE}@${latest}:
${result.output}`);
    lines.push(`cli: ${current} \u2192 ${latest}`);
  }
  run2("claude", ["plugin", "marketplace", "update", MARKETPLACE]);
  const plugin = run2("claude", ["plugin", "update", PLUGIN]);
  const isLatest = /already at the latest/i.test(plugin.output);
  lines.push(plugin.status !== 0 ? `plugin: not updated \u2014 ${plugin.output.trim().split("\n")[0]}` : isLatest ? "plugin: already the latest" : "plugin: updated \u2014 restart Claude Code to load it");
  return lines;
}

// cli/src/setup/update/update.command.ts
async function refresh(env2, repo) {
  console.log(formatModels(await writeModels()));
  if (!existsSync40(join52(repo, CONFIG_FILE))) return;
  const result = await syncRepo(repo, { canonRoot: env2.canonRoot, cacheDir: CACHE_DIR, fetchText, run: runCommand });
  console.log(`packs refreshed: ${result.packs.join(", ") || "none"}`);
  if (result.base) console.log("architecture base updated from canon's template");
  if (result.version) console.log(`canon ${result.version.from ?? "unpinned"} \u2192 ${result.version.to}`);
  const report = runChecks(repo, { canonRoot: env2.canonRoot });
  console.log(formatReports([report]));
  process.exitCode = exitCode([report]);
}
function registerUpdate(program3, env2) {
  program3.command("update").description("update the canon CLI and its Claude Code plugin to the latest release, then refresh this repo: packs, search index, pinned version, models").argument("[repo]", "product repo", ".").option("--refresh", "only refresh this repo and the models, installing nothing").action(async (repo, options) => {
    const path2 = resolve16(repo);
    if (options.refresh) return refresh(env2, path2);
    for (const line of await updateCanon({ canonRoot: env2.canonRoot, run: runCommand, fetchText })) console.log(line);
    const result = spawnSync15("canon", ["update", "--refresh", path2], { stdio: "inherit" });
    if (result.error) throw new Error(`could not run canon update --refresh: ${result.error.message}`);
    process.exitCode = result.status ?? 1;
  });
}

