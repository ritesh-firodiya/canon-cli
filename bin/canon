var MODELS_URL = "https://api.anthropic.com/v1/models?limit=1000";
var API_VERSION = "2023-06-01";
var LOOKUP_TIMEOUT_MS = 5e3;
async function apiModelIds(key2, fetcher = fetch) {
  if (!key2) return { ids: [], error: null };
  try {
    const response = await fetcher(MODELS_URL, { headers: { "x-api-key": key2, "anthropic-version": API_VERSION }, signal: AbortSignal.timeout(LOOKUP_TIMEOUT_MS) });
    if (!response.ok) return { ids: [], error: `/v1/models answered HTTP ${response.status}` };
    const rows2 = (await response.json()).data ?? [];
    return { ids: rows2.map((row) => row.id).filter((id) => typeof id === "string"), error: null };
  } catch (error62) {
    return { ids: [], error: `/v1/models: ${error62.message}` };
  }
}
async function writeModels(fetcher) {
  const api = await apiModelIds(process.env.ANTHROPIC_API_KEY, fetcher);
  const models = gatherModels({ ...machineModels(), apiIds: api.ids });
  const result = { at: (/* @__PURE__ */ new Date()).toISOString(), models, warnings: api.error ? [api.error] : [] };
  mkdirSync5(dirname9(modelsFile()), { recursive: true });
  writeFileSync7(modelsFile(), `${JSON.stringify(result, null, 2)}
`);
  return result;
}
var usd = (value) => `$${value}`;
function formatModels(file2) {
  const lines = file2.models.map((m2) => `${m2.id.padEnd(32)} ${(m2.size ?? "no size").padEnd(8)} ${m2.price ? `${usd(m2.price.input)} in, ${usd(m2.price.output)} out per M` : "price ?"}   ${m2.source}${m2.runs ? `, list price of ${m2.runs}` : ""}`);
  const unsized = file2.models.filter((m2) => !m2.size).length;
  return [
    ...lines,
    ...file2.warnings.map((warning) => `warning: ${warning}`),
    ...unsized ? [`${unsized} model(s) have no size and are never routed to: set one in ${configFile()}`] : [],
    `wrote ${modelsFile()}`
  ].join("\n");
}

