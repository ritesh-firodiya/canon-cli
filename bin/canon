var price = (input2, write5m, write1h, cacheRead, output2) => ({ input: input2, write5m, write1h, cacheRead, output: output2 });
var HAIKU_LARGE_PROMPT = 1e5;
var HAIKU_LARGE = price(0.5, 0.625, 1, 0.05, 2.5);
var PER_MILLION = 1e6;
var PRICES = [
  ["claude-fable-5-1", price(10, 12.5, 20, 0.25, 50)],
  ["claude-mythos-5-1", price(10, 12.5, 20, 0.25, 50)],
  ["claude-fable-5", price(10, 12.5, 20, 1, 50)],
  ["claude-mythos-5", price(10, 12.5, 20, 1, 50)],
  ["claude-opus-5-5", price(4, 5, 8, 0.2, 20)],
  ["claude-opus-5", price(5, 6.25, 10, 0.5, 25)],
  ["claude-opus-4-8", price(5, 6.25, 10, 0.5, 25)],
  ["claude-opus-4-7", price(5, 6.25, 10, 0.5, 25)],
  ["claude-opus-4-6", price(5, 6.25, 10, 0.5, 25)],
  ["claude-opus-4-5", price(5, 6.25, 10, 0.5, 25)],
  ["claude-sonnet-5-5", price(2, 2.5, 4, 0.1, 10)],
  ["claude-sonnet-5", price(2, 2.5, 4, 0.2, 10)],
  ["claude-sonnet-4-6", price(3, 3.75, 6, 0.3, 15)],
  ["claude-sonnet-4-5", price(3, 3.75, 6, 0.3, 15)],
  ["claude-haiku-5-5", price(0.1, 0.125, 0.2, 0.01, 0.5)],
  ["claude-haiku-4-5", price(1, 1.25, 2, 0.1, 5)]
].sort((a2, b) => b[0].length - a2[0].length);
var tokens2 = (value) => typeof value === "number" && Number.isFinite(value) ? value : 0;
var promptTokens = (usage) => tokens2(usage.input_tokens) + tokens2(usage.cache_creation_input_tokens) + tokens2(usage.cache_read_input_tokens);
function listId(id) {
  const bare = id.replace(/\[[^\]]*\]$/, "");
  return bare.includes("claude-") ? bare.slice(bare.indexOf("claude-")) : bare;
}
function priceOf(id, prompt) {
  const model = listId(id);
  const found = PRICES.find(([prefix]) => model.startsWith(prefix))?.[1] ?? null;
  return found && model.startsWith("claude-haiku-5-5") && prompt > HAIKU_LARGE_PROMPT ? HAIKU_LARGE : found;
}
function costOf(usage, rate) {
  if (!rate) return null;
  const written = tokens2(usage.cache_creation_input_tokens);
  const short = tokens2(usage.cache_creation?.ephemeral_5m_input_tokens);
  const long = usage.cache_creation ? tokens2(usage.cache_creation.ephemeral_1h_input_tokens) : written;
  return {
    input: tokens2(usage.input_tokens) * rate.input / PER_MILLION,
    output: tokens2(usage.output_tokens) * rate.output / PER_MILLION,
    cacheWrite: (short * rate.write5m + long * rate.write1h) / PER_MILLION,
    cacheRead: tokens2(usage.cache_read_input_tokens) * rate.cacheRead / PER_MILLION
  };
}

