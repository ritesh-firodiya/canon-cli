// cli/src/setup/features/features.command.ts
import { spawnSync as spawnSync17 } from "node:child_process";
import { resolve as resolve19 } from "node:path";
function registerFeatures(program3) {
  const on = (isOn) => (name, repo, options) => {
    const root = resolve19(repo);
    const features = options.user ? setUserFeature(name, isOn) : setFeature(root, name, isOn);
    const args = pluginCommand(name, isOn, options.user ? "user" : "project");
    console.log(`${name} ${isOn ? "on" : "off"}. On ${options.user ? "across this machine" : "in this repo"}: ${features.join(", ") || "only the band"}`);
    if (!args) return;
    const run2 = spawnSync17("claude", args, { cwd: root, encoding: "utf8" });
    if (run2.status === 0) return;
    console.error(`could not change the plugin. Run this in the repo: claude ${args.join(" ")}`);
    process.exitCode = 1;
  };
  program3.command("enable").description(`turn a feature on for a repo: ${FEATURES.join(", ")}. Only the band is on by default`).argument("<feature>").argument("[repo]", "product repo", ".").option("--user", "across this machine: every repo and any other folder").action(on(true));
  program3.command("disable").description("turn a feature off for a repo").argument("<feature>").argument("[repo]", "product repo", ".").option("--user", "across this machine: every repo and any other folder").action(on(false));
}

