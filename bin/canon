// cli/src/config/load.ts
var EXPO_MARKERS = ["app.config.ts", "app.config.js", "app.json"];
var WEB_MARKERS = ["next.config.ts", "next.config.js", "next.config.mjs", "vite.config.ts"];
function configPath(folder) {
  return join3(folder, CONFIG_FILE);
}
function readLayer(path2) {
  const parsed = layerSchema.safeParse((0, import_yaml2.parse)(readFileSync2(path2, "utf8")) ?? {});
  if (!parsed.success) {
    const problems2 = parsed.error.issues.map((issue2) => `${issue2.path.join(".") || "(root)"}: ${issue2.message}`);
    throw new Error(`${path2} is invalid:
  ${problems2.join("\n  ")}`);
  }
  return parsed.data;
}
function extendedFiles(path2, seen = []) {
  if (seen.includes(path2)) throw new Error(`extends goes in a circle at ${path2}`);
  return (readLayer(path2).extends ?? []).flatMap((entry) => {
    const parent = resolve2(dirname2(path2), entry);
    if (!existsSync2(parent)) throw new Error(`${path2} extends ${entry}, which does not exist`);
    return [...extendedFiles(parent, [...seen, path2]), parent];
  });
}
function valueAt(root, key2) {
  return key2.split(".").reduce((value, part) => {
    if (Array.isArray(value)) return value.find((item) => item?.id === part || item?.folder === part);
    return value && typeof value === "object" ? value[part] : void 0;
  }, root);
}
function appRoots(repo) {
  const apps = join3(repo, "apps");
  if (!existsSync2(apps)) return [repo];
  const children = readdirSync2(apps, { withFileTypes: true }).filter((entry) => entry.isDirectory());
  return [repo, ...children.map((entry) => join3(apps, entry.name))];
}
function isPackage(repo) {
  const file2 = join3(repo, "package.json");
  if (!existsSync2(file2)) return false;
  const pkg = JSON.parse(readFileSync2(file2, "utf8"));
  return Boolean(pkg.bin || pkg.exports || pkg.main) && !pkg.private;
}
function inferKind(repo) {
  const roots = appRoots(repo);
  const anyHas = (markers) => roots.some((root) => markers.some((file2) => existsSync2(join3(root, file2))));
  const mobile = anyHas(EXPO_MARKERS);
  const web = anyHas(WEB_MARKERS);
  if (mobile && web) return "mobile-and-web";
  if (mobile) return "mobile";
  if (web) return "web";
  return isPackage(repo) ? "package" : "content";
}
function inferModules(repo, kind) {
  return withDesign(repo, MODULES_BY_KIND[kind]);
}
function withDesign(repo, modules) {
  const hasDesigns = existsSync2(join3(repo, ".context", "designs"));
  return hasDesigns && !modules.includes("design") ? [...modules, "design"] : modules;
}
function sourceSets(source, repo) {
  if (!source || resolve2(source) === resolve2(repo) || !existsSync2(configPath(source))) return {};
  return readLayer(configPath(source)).copies?.sets ?? {};
}
function lastDefined(values) {
  return values.filter((value) => value !== void 0).pop();
}
function resolveRecords(changes) {
  const removed = new Set(changes.filter((entry) => entry.remove).map((entry) => entry.folder));
  const kinds = changes.filter((entry) => !entry.remove);
  const changedDefaults = DEFAULT_RECORDS.filter((kind) => !removed.has(kind.folder)).map((kind) => {
    const entry = kinds.find((item) => item.folder === kind.folder);
    if (!entry) return kind;
    const statuses = entry.statuses ?? kind.statuses;
    const inherited = { ...kind.meanings, status: Object.fromEntries(Object.entries(kind.meanings.status ?? {}).filter(([status]) => statuses.includes(status))) };
    const { fields, removedFields } = splitFields(kind.fields, entry);
    return { ...kind, ...entry, fields, removed: removedFields, closed: entry.closed ?? kind.closed.filter((status) => statuses.includes(status)), meanings: mergeMeanings(inherited, entry.meanings) };
  });
  const added = kinds.filter((entry) => !DEFAULT_RECORDS.some((kind) => kind.folder === entry.folder)).map((entry) => {
    if (!entry.prefix && !entry.named || !entry.statuses) throw new Error(`records: ${entry.folder} is new, so it needs a prefix (or named: true) and statuses`);
    const { fields, removedFields } = splitFields({}, entry);
    return { ...entry, prefix: entry.prefix ?? "", statuses: entry.statuses, closed: entry.closed ?? [], meanings: entry.meanings ?? {}, fields, removed: removedFields, required: entry.required ?? [], sections: entry.sections ?? [] };
  });
  const records2 = [...changedDefaults, ...added];
  for (const kind of records2) {
    const unknown2 = Object.keys(kind.meanings.status ?? {}).concat(kind.closed).filter((status) => !kind.statuses.includes(status));
    if (unknown2.length) throw new Error(`records: ${kind.folder} has no status ${unknown2.join(", ")}`);
    const impossible = kind.required.filter((field) => kind.removed.includes(field));
    if (impossible.length) throw new Error(`records: ${kind.folder} both requires and removes ${impossible.join(", ")}`);
  }
  const prefixes = records2.map((kind) => kind.prefix).filter(Boolean);
  const repeated = prefixes.find((prefix, index) => prefixes.indexOf(prefix) !== index);
  if (repeated) throw new Error(`records: two kinds use the prefix ${repeated}`);
  return records2;
}
function splitFields(base, entry) {
  const merged = { ...base, ...entry.fields };
  const removedFields = Object.keys(merged).filter((field) => merged[field] === "remove");
  return { fields: Object.fromEntries(Object.entries(merged).filter(([, rule]) => rule !== "remove")), removedFields };
}
function mergeMeanings(base, extra = {}) {
  return Object.fromEntries([.../* @__PURE__ */ new Set([...Object.keys(base), ...Object.keys(extra)])].map((field) => [field, { ...base[field], ...extra[field] }]));
}
function resolvePipelines(pipelines) {
  const resolved2 = Object.entries(pipelines).map(([name, stages]) => {
    const specs = stages.map((stage2) => {
      const { after: _after, ...inherited } = DEFAULT_PIPELINE.find((entry) => entry.id === stage2.id) ?? {};
      const by = stage2.by ?? inherited.by;
      if (!by) throw new Error(`pipelines.${name}: stage "${stage2.id}" is not a canon stage; say by: agent or by: person`);
      return { ...inherited, ...stage2, by, done: stage2.done ?? inherited.done ?? [], gate: stage2.gate ?? inherited.gate ?? false };
    });
    const problem = afterProblem(specs);
    if (problem) throw new Error(`pipelines.${name}: ${problem}`);
    return [name, specs];
  });
  return { default: DEFAULT_PIPELINE, ...Object.fromEntries(resolved2) };
}
function mergeBy(lists, key2) {
  const merged = /* @__PURE__ */ new Map();
  for (const item of lists.flat()) merged.set(key2(item), item);
  return [...merged.values()];
}
function loadConfig(repo) {
  const candidates = [
    { layer: "product", path: configPath(repo) },
    { layer: "local", path: join3(repo, LOCAL_CONFIG_FILE) }
  ];
  const own2 = candidates.filter((source2) => existsSync2(source2.path));
  const inherited = [...new Set(own2.flatMap((source2) => extendedFiles(source2.path)))].map((path2) => ({ layer: "extends", path: path2 }));
  const sources3 = [...inherited, ...own2];
  const layers = sources3.map((source2) => ({ path: source2.path, data: readLayer(source2.path), base: source2.layer === "extends" ? dirname2(source2.path) : dirname2(dirname2(source2.path)) }));
  const inheritedLayers = layers.slice(0, inherited.length);
  const pick2 = (key2) => layers.map((layer) => layer.data[key2]);
  const kind = lastDefined(pick2("kind")) ?? inferKind(repo);
  const source = lastDefined(layers.map((layer) => layer.data.copies?.source ? resolve2(layer.base, layer.data.copies.source) : void 0));
  const config2 = {
    canon: lastDefined(pick2("canon")),
    kind,
    modules: withDesign(repo, lastDefined(pick2("modules")) ?? MODULES_BY_KIND[kind]),
    features: lastDefined(pick2("features")) ?? [],
    expo: Object.assign({}, ...pick2("expo")),
    packs: [...new Set(pick2("packs").flatMap((packs) => packs ?? []))].sort(),
    standards: [...new Set(layers.flatMap((layer) => (layer.data.standards ?? []).map((entry) => isStandardName(entry) ? entry : resolve2(layer.base, entry))))],
    commands: mergeBy(pick2("commands").map((list) => list ?? []), (command2) => command2.id),
    doctor: { tools: mergeBy(pick2("doctor").map((doctor) => doctor?.tools ?? []), (tool2) => tool2.tool) },
    wiki: { types: mergeBy(pick2("wiki").map((wiki) => wiki?.types ?? []), (entry) => entry.type) },
    context: {
      folders: mergeBy(pick2("context").map((context) => context?.folders ?? []), (entry) => entry.folder),
      rootFolders: mergeBy(pick2("context").map((context) => context?.rootFolders ?? []), (entry) => entry.folder)
    },
    pipelines: resolvePipelines(Object.assign({}, ...pick2("pipelines"))),
    baseline: { pipelines: resolvePipelines(Object.assign({}, ...inheritedLayers.map((layer) => layer.data.pipelines))), cap: lastDefined(inheritedLayers.map((layer) => layer.data.cap)) },
    locks: layers.flatMap((layer) => (layer.data.locked ?? []).map((key2) => ({ key: key2, value: valueAt(layer.data, key2), layer: layer.path }))),
    connectors: mergeBy(pick2("connectors").map((list) => list ?? []), (entry) => entry.id),
    triggers: mergeBy(pick2("triggers").map((list) => list ?? []), (entry) => entry.id),
    records: resolveRecords(mergeBy(pick2("records").map((list) => list ?? []), (entry) => entry.folder)),
    name: lastDefined(pick2("name")),
    cap: lastDefined(pick2("cap")),
    agent: lastDefined(pick2("agent")),
    priorities: lastDefined(pick2("priorities")) ?? DEFAULT_PRIORITIES,
    owner: lastDefined(pick2("owner")),
    product: lastDefined(pick2("product")),
    team: lastDefined(pick2("team")),
    formerly: [...new Set(pick2("formerly").flatMap((names) => names ?? []))],
    copies: {
      source,
      sets: Object.assign({}, sourceSets(source, repo), ...pick2("copies").map((copies) => copies?.sets)),
      use: [...new Set(pick2("copies").flatMap((copies) => copies?.use ?? []))]
    }
  };
  if (config2.name === void 0) delete config2.name;
  if (config2.cap === void 0) delete config2.cap;
  if (config2.agent === void 0) delete config2.agent;
  if (config2.owner === void 0) delete config2.owner;
  if (config2.product === void 0) delete config2.product;
  if (config2.team === void 0) delete config2.team;
  if (Object.keys(config2.expo ?? {}).length === 0) delete config2.expo;
  return { config: config2, sources: sources3 };
}

// cli/src/work/pipeline/pipeline.ts
import { existsSync as existsSync4 } from "node:fs";
