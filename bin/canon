function transcriptFiles(root = TRANSCRIPTS, since) {
  if (!existsSync27(root)) return [];
  return readdirSync20(root, { recursive: true }).filter((file2) => file2.endsWith(".jsonl")).map((file2) => join36(root, file2)).filter((file2) => !since || statSync5(file2).mtime >= since);
}
function perTranscript(kind, files, compute, cacheDir = CACHE_DIR) {
  const file2 = join36(cacheDir, "transcripts", `${kind}.json`);
  let cache = {};
  try {
    cache = JSON.parse(readFileSync25(file2, "utf8"));
  } catch {
  }
  const next = {};
  const values = files.map((path2) => {
    const { mtimeMs, size } = statSync5(path2);
    const hit = cache[path2];
    const value = hit && hit.mtimeMs === mtimeMs && hit.size === size ? hit.value : compute(path2);
    next[path2] = { mtimeMs, size, value };
    return value;
  });
  mkdirSync4(dirname8(file2), { recursive: true });
  writeFileSync6(file2, JSON.stringify(next));
  return values;
}

