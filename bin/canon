// cli/src/setup/doctor/doctor.ts
import { spawnSync as spawnSync9 } from "node:child_process";
var CORE_TOOLS = [
  { tool: "node", why: "runs the canon CLI and hooks", hint: "install Node 22+", minimum: [22, 0] },
  { tool: "git", why: "canon works on git repos", hint: "install git" },
  { tool: "qmd", why: "knowledge search for Claude", hint: "npm i -g @tobilu/qmd (see the canon README)" }
];
var VERSION = /(\d+)\.(\d+)(?:\.(\d+))?/;
var systemProbe = (command2) => {
  const result = spawnSync9(command2, ["--version"], { encoding: "utf8" });
  if (result.error || result.status !== 0) return null;
  return `${result.stdout}${result.stderr}`.trim().split("\n")[0];
};
function runDoctor(probe = systemProbe, extra = []) {
  const tools = [...CORE_TOOLS, ...extra];
  return tools.map(({ tool: tool2, why, hint, minimum }) => {
    const output2 = probe(tool2);
    if (output2 === null) return { tool: tool2, ok: false, why, hint };
    const match = VERSION.exec(output2);
    const version2 = match?.[0];
    if (minimum && match) {
      const [major, minor] = [Number(match[1]), Number(match[2])];
      const tooOld = major < minimum[0] || major === minimum[0] && minor < minimum[1];
      if (tooOld) return { tool: tool2, ok: false, version: version2, why, hint };
    }
    return { tool: tool2, ok: true, version: version2, why };
  });
}

// cli/src/setup/doctor/doctor.command.ts
