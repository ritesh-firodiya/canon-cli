function runCommand(command2, args) {
  const result = spawnSync(command2, args, { encoding: "utf8" });
  if (result.error) {
    const missing = result.error.code === "ENOENT";
    return { status: 1, output: missing ? `${command2} is not installed \u2014 run \`canon doctor\`` : result.error.message };
  }
  return { status: result.status ?? 1, output: `${result.stdout}${result.stderr}` };
}
async function fetchText(url2) {
  const response = await fetch(url2, { signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return response.text();
}

