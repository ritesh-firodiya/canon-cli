function toProposal(id, summary, entries) {
  return {
    id,
    summary,
    count: entries.length,
    products: [...new Set(entries.map((e) => e.product))].sort(),
    reasons: [...new Set(entries.map((e) => e.reason))].slice(0, MAX_REASONS)
  };
}
function proposals(all, options) {
  const entries = all.filter((entry) => entry.outcome === "overridden");
  const found = [];
  for (const [principle, group_] of group(entries, (e) => e.principles)) {
    if (group_.length >= options.threshold) {
      found.push(toProposal(`principle:${principle}`, `${principle} was overridden ${group_.length} times \u2014 revisit the rule or its wording`, group_));
    }
  }
  for (const [reason2, group_] of group(entries, (e) => [e.reason])) {
    const products = new Set(group_.map((e) => e.product));
    if (products.size >= 2) {
      found.push(toProposal(`reason:${reason2}`, `"${reason2}" was given in ${products.size} products \u2014 a missing exception?`, group_));
    }
  }
  const decidedAt = new Map(options.decisions.map((d) => [d.id, d.count]));
  return found.filter((p) => !decidedAt.has(p.id) || p.count > (decidedAt.get(p.id) ?? 0));
}
