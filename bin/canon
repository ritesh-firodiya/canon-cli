var KEYWORDS = /* @__PURE__ */ new Set(["cancel", "destructive", "default", "plain", "success", "error", "warning", "warn", "info", "ask", "neutral"]);
var STRING = /"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)'/g;
var CODE = /^(?:[a-z0-9]+(?:-[a-z0-9]+)+|[a-z]+(?:[A-Z][a-z0-9]*)+)$/;
var TEMPLATE = /`(?:[^`\\]|\\.)*`/g;
var T_CALL = /\bt\(\s*["']([\w.-]+)["']\s*\)/g;
function isCopy(text) {
  if (KEYWORDS.has(text.toLowerCase()) || !/[A-Za-z]/.test(text) || text.length < 2) return false;
  if (CODE.test(text)) return false;
  return text.includes(" ") || !/[/:._]/.test(text);
}
function dictionary(s) {
