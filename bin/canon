function addProblem(repo, config2, options) {
  return newPage(repo, config2, "problems", options.title, { source: options.source, ...options.priority ? { priority: options.priority } : {}, ...options.pipeline ? { pipeline: options.pipeline } : {} });
}
function recordEvent(repo, config2, source, event, options) {
  const now = (options.now ?? /* @__PURE__ */ new Date()).toISOString();
  const open2 = allRecords(repo, config2).filter((record2) => record2.kind.folder === "problems" && !record2.kind.closed.includes(String(record2.data.status)));
  for (const record2 of open2) {
    const sources3 = record2.data.sources ?? [];
    if (sources3.some((entry) => entry.source === source && entry.id === event.id)) {
      setFields(repo, record2.file, { sources: sources3.map((entry) => entry.source === source && entry.id === event.id ? { ...entry, count: entry.count + 1, last: now } : entry) });
      return { id: record2.id, file: record2.file, isNew: false };
    }
  }
  const created = addProblem(repo, config2, { title: `${source} ${event.id}`, source, priority: options.priority, pipeline: options.pipeline });
  const firstStage = config2.pipelines[options.pipeline ?? "default"]?.[0]?.id;
  setFields(repo, created.file, { sources: [{ source, id: event.id, ...event.link ? { link: event.link } : {}, count: 1, first: now, last: now }], ...firstStage ? { "started-at": firstStage } : {} });
  return { ...created, isNew: true };
}
function openFollowUp(repo, config2, record2) {
  if (!["discarded", "retried"].includes(String(record2.data.outcome))) return;
  if (allRecords(repo, config2).some((other) => other.data.source === record2.id)) return;
  const pipeline2 = String(record2.data.pipeline ?? "default");
  const created = addProblem(repo, config2, { title: `After ${record2.id}: ${String(record2.data.outcome)}`, source: record2.id, pipeline: record2.data.pipeline ? pipeline2 : void 0 });
  const firstStage = config2.pipelines[pipeline2]?.[0]?.id;
  if (firstStage) setFields(repo, created.file, { "started-at": firstStage });
}

