  return new Map([...read(file2).matchAll(entry)].map((m2) => [m2[1], m2[2] ?? m2[3]]));
}
function callArguments(text, open2) {
  let depth = 0;
  for (let i2 = open2; i2 < text.length; i2 += 1) {
    if (text[i2] === "(") depth += 1;
    else if (text[i2] === ")" && --depth === 0) return text.slice(open2 + 1, i2);
  }
  return text.slice(open2 + 1);
}
function sources(dir) {
