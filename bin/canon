function planInit(repo, answers) {
  if (existsSync28(join38(repo, CONFIG_FILE)) && !answers.force) {
    throw new Error(`${repo} is already set up (.context/context.yaml exists) \u2014 use --force to redo it`);
  }
  const kind = answers.kind ?? inferKind(repo);
  const modules = answers.modules ?? (answers.kind ? MODULES_BY_KIND[kind] : inferModules(repo, kind));
  const sdk = kindCovers(kind, "mobile") ? detectExpoSdk(repo) : void 0;
  const packs = answers.packs?.length ? { packs: answers.packs } : {};
  const config2 = { canon: answers.canonVersion, kind, modules, ...sdk ? { expo: { sdk } } : {}, ...packs };
  const create = requiredContext(modules, void 0, kind).filter((name) => !existsSync28(join38(repo, ".context", name))).map((name) => FIRST_FILE[name]);
  if (!existsSync28(join38(repo, CI_WORKFLOW))) create.push(CI_WORKFLOW);
  if (modules.includes("architecture")) {
    const taken = (file2) => file2 === ARCHITECTURE_BASE ? existsSync28(join38(repo, file2)) : RULES_FILES.some((name) => existsSync28(join38(repo, dirname10(file2), name)));
    create.push(...architectureStarters(repo).map((s) => s.file).filter((file2) => !taken(file2)));
  }
  return { config: config2, create };
}
function applyInit(repo, plan, options) {
  const write = (file2, content) => {
    mkdirSync6(dirname10(join38(repo, file2)), { recursive: true });
    writeFileSync8(join38(repo, file2), content);
  };
  write(CONFIG_FILE, (0, import_yaml5.stringify)(plan.config));
  const starters = new Map(architectureStarters(repo).map((s) => [s.file, s.template]));
  for (const file2 of plan.create) {
    const starter = starters.get(file2);
    if (file2 === CI_WORKFLOW) {
      write(file2, ciWorkflow(plan.config.canon));
      continue;
    }
    write(file2, starter ? readFileSync27(join38(options.canonRoot, ARCHITECTURE_TEMPLATES, starter), "utf8") : template(file2));
  }
  if (plan.config.modules.includes("knowledge")) indexKnowledge(repo, options.name, options.run);
}
function indexKnowledge(repo, name, run2) {
  const folders2 = loadConfig(repo).config.records.map((kind) => kind.folder).filter((folder) => folder === "features" || existsSync28(join38(repo, ".context", folder)));
  const kinds = ["wiki", ...folders2];
  for (const kind of kinds) run2("qmd", ["collection", "remove", `${name}-${kind}`]);
  run2("qmd", ["collection", "add", join38(repo, ".context"), "--name", name, "--mask", `{${kinds.join(",")}}/**/*.md`]);
}

