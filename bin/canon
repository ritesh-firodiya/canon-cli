// cli/src/enforce/checks/check.ts
var calendarDay = (now) => new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
function runChecks(repo, options) {
  const report = { repo, name: basename7(repo), findings: [], skipped: [] };
  if (!isDirectory(repo)) {
    report.findings.push({ check: "repo", level: "error", message: `no folder at ${repo}` });
    return report;
  }
  let config2;
  try {
    config2 = loadConfig(repo).config;
  } catch (error62) {
    report.findings.push({ check: "config", level: "error", message: error62.message });
    return report;
  }
  for (const check2 of options.checks ?? ALL_CHECKS) {
    if (check2.module && !config2.modules.includes(check2.module)) {
      report.skipped.push({ check: check2.id, why: `module ${check2.module} is off` });
      continue;
    }
    try {
      report.findings.push(
        ...check2.run({ repo, name: report.name, config: config2, canonRoot: options.canonRoot, today: options.today ?? calendarDay(/* @__PURE__ */ new Date()) })
      );
    } catch (error62) {
      report.findings.push({ check: check2.id, level: "error", message: `check crashed: ${error62.message}` });
    }
  }
  return report;
}
function findProducts(workspace) {
  return readdirSync16(workspace, { withFileTypes: true }).filter((entry) => entry.isDirectory() && existsSync23(join31(workspace, entry.name, ".context"))).map((entry) => join31(workspace, entry.name)).sort();
}
function findWorkspace(start) {
  let folder = resolve6(start);
  while (!existsSync23(join31(folder, ".git")) && dirname6(folder) !== folder) folder = dirname6(folder);
  const workspace = existsSync23(join31(folder, ".git")) ? dirname6(folder) : resolve6(start);
  try {
    return findProducts(workspace).length > 0 ? workspace : null;
  } catch {
    return null;
  }
}

// cli/src/enforce/standards/standards.ts
import { existsSync as existsSync24, readdirSync as readdirSync17, readFileSync as readFileSync20 } from "node:fs";
import { join as join32 } from "node:path";
var NOT_STANDARDS = /* @__PURE__ */ new Set(["README.md"]);
var PRINCIPLE = /^### (C-\d{2}) (.+)$/;
function markdownIn(dir) {
  return readdirSync17(dir).filter((file2) => file2.endsWith(".md") && !NOT_STANDARDS.has(file2));
}
function libraryStandards(canonRoot) {
  const dir = join32(canonRoot, "standards", "library");
  return existsSync24(dir) ? markdownIn(dir).map((file2) => file2.replace(/\.md$/, "")).sort() : [];
}
function libraryFile(canonRoot, name) {
  const path2 = join32(canonRoot, "standards", "library", `${name}.md`);
  if (!existsSync24(path2)) throw new Error(`no canon standard named ${name} \u2014 canon has: ${libraryStandards(canonRoot).join(", ")}`);
  return path2;
}
function resolveStandards(canonRoot, entries) {
  const byName = /* @__PURE__ */ new Map();
  const add = (name, path2, from) => {
    byName.set(name === "constitution" ? `${name}:${from}` : name, { name, path: path2, from });
  };
  const defaults = join32(canonRoot, "standards");
  for (const entry of [defaults, ...entries]) {
    if (isStandardName(entry)) {
      add(entry, libraryFile(canonRoot, entry), "canon library");
      continue;
    }
    if (!existsSync24(entry)) throw new Error(`standards folder not found: ${entry}`);
    const from = entry === defaults ? "canon" : entry;
    for (const file2 of markdownIn(entry)) add(file2.replace(/\.md$/, ""), join32(entry, file2), from);
  }
  return [...byName.values()].sort((a2, b) => a2.name.localeCompare(b.name) || Number(a2.from !== "canon") - Number(b.from !== "canon"));
}
function constitutionTitles(canonRoot, entries) {
  const titles = /* @__PURE__ */ new Map();
  const files = [join32(canonRoot, "standards"), ...entries].map(
    (entry) => isStandardName(entry) ? libraryFile(canonRoot, entry) : join32(entry, "constitution.md")
  );
  for (const file2 of files) {
    if (!existsSync24(file2)) continue;
    for (const line of readFileSync20(file2, "utf8").split("\n")) {
      const match = PRINCIPLE.exec(line);
      if (match) titles.set(match[1], `${match[1]} ${match[2]}`);
    }
  }
  return [...titles.values()];
}

// cli/src/enforce/status/status.ts
import { existsSync as existsSync25, readdirSync as readdirSync18, readFileSync as readFileSync21 } from "node:fs";
import { join as join33 } from "node:path";
function canonVersion(canonRoot) {
  const manifest = join33(canonRoot, ".claude-plugin", "plugin.json");
  if (!existsSync25(manifest)) return "unknown";
  return JSON.parse(readFileSync21(manifest, "utf8")).version ?? "unknown";
}
function weakened(config2) {
  const lines = Object.entries(config2.baseline.pipelines).flatMap(([name, baseline]) => {
    const own2 = config2.pipelines[name] ?? [];
    return baseline.flatMap((stage2) => {
      const mine = own2.find((entry) => entry.id === stage2.id);
      if (!mine) return [`${name}: stage ${stage2.id} removed${stage2.gate ? ", and its gate" : ""}`];
      return [
        ...stage2.gate && !mine.gate ? [`${name}: gate ${stage2.id} removed`] : [],
        ...stage2.cap && mine.cap && mine.cap > stage2.cap ? [`${name}: ${stage2.id} cap raised from $${stage2.cap} to $${mine.cap}`] : []
      ];
    });
  });
  const cap = config2.baseline.cap;
  return [...lines, ...cap && config2.cap && config2.cap > cap ? [`cap raised from $${cap} to $${config2.cap}`] : []];
}
function enforcement(repo) {
  const hook = join33(repo, ".git", "hooks", "pre-push");
  const hasHook = existsSync25(hook) && readFileSync21(hook, "utf8").includes("canon");
  const workflows = join33(repo, ".github", "workflows");
  const hasCi = existsSync25(workflows) && readdirSync18(workflows).some((file2) => readFileSync21(join33(workflows, file2), "utf8").includes("canon") && readFileSync21(join33(workflows, file2), "utf8").includes(" check"));
  return [...hasHook ? [] : ["no pre-push hook: run canon hooks install"], ...hasCi ? [] : ["no CI job running canon check: nothing stops a push that skips the hook"]];
}
function buildStatus(repo, options) {
  const { config: config2, sources: sources3 } = loadConfig(repo);
  const report = runChecks(repo, options);
  const errors = report.findings.filter((f) => f.level === "error").length;
  const warnings = report.findings.length - errors;
  const configLine = sources3.length === 0 ? "none \u2014 inferred; run `canon init`" : sources3.map((source) => `${source.layer} ${source.path}`).join("\n         ");
  return [
    `canon ${canonVersion(options.canonRoot)}  \xB7  ${report.name}`,
    `kind     ${config2.kind}`,
    `modules  ${config2.modules.join(", ")}`,
    `config   ${configLine}`,
    `checks   ${errors} error${errors === 1 ? "" : "s"}, ${warnings} warning${warnings === 1 ? "" : "s"}`,
    ...enforcement(repo).map((line) => `enforce  ${line}`),
    ...weakened(config2).map((line) => `weaker   ${line}`)
  ].join("\n");
}

// cli/src/lib/env.ts
function requireWorkspace(env2) {
  if (env2.workspace) return env2.workspace;
  throw new Error("no products found \u2014 run this in a product repo or the folder that holds them, or set CANON_WORKSPACE");
}

// cli/src/enforce/checks/check.command.ts
function printStandards(env2, repo, options) {
  const { config: config2 } = loadConfig(repo);
  if (options.constitution) {
    const titles = constitutionTitles(env2.canonRoot, config2.standards);
    console.log(options.json ? JSON.stringify(titles) : titles.map((title) => `- ${title}`).join("\n"));
    return;
  }
  const standards = resolveStandards(env2.canonRoot, config2.standards);
  console.log(options.json ? JSON.stringify(standards, null, 2) : standards.map((s) => `${s.name.padEnd(18)} ${s.path}`).join("\n"));
}
function printCopies(repo, options) {
  const { config: config2 } = loadConfig(repo);
  if (options.sync) {
    const written = syncCopies(repo, config2);
    console.log(written.length ? written.map((file2) => `  synced: ${file2}`).join("\n") : "  nothing to sync");
    return;
  }
  const off = compareCopies(repo, config2).filter((entry) => entry.state !== "same");
  console.log(off.length ? off.map(({ pair, state }) => `  ${state}: ${pair.to}`).join("\n") : "  ok");
  if (off.length) process.exitCode = 1;
}
function printDrift(repo) {
  const findings = runDrift(repo);
  console.log(findings.length ? findings.map((f) => `${f.level} ${f.file} \u2014 ${f.message}`).join("\n") : "ok: each wiki page matches the code it names");
  if (findings.some((f) => f.level === "error")) process.exitCode = 1;
}
function registerCheck(program3, env2) {
  program3.command("check").description("check that a product follows the standards (read-only), or show what applies to it").argument("[repo]", "product repo", ".").option("--all", "check every product in the workspace").option("--json", "print machine-readable JSON").option("-q, --quiet", "hide products with no findings").option("--status", "one screen: canon version, config and the check summary").option("--standards", "list the standards that apply: canon's defaults, then the ones the repo imports").option("--constitution", "with --standards: only the principle titles").option("--copies", "compare the shared files with copies.source").option("--sync", "with --copies: overwrite the drifted ones (never adds a missing file)").option("--drift", drift.description.replace(/^each/, "run only the drift check: each")).action((repo, options) => {
    const path2 = resolve7(repo);
    if (options.status) return void console.log(buildStatus(path2, { canonRoot: env2.canonRoot }));
    if (options.standards || options.constitution) return printStandards(env2, path2, options);
    if (options.drift) return printDrift(path2);
    if (options.copies) return printCopies(path2, options);
    const repos = options.all ? findProducts(requireWorkspace(env2)) : [path2];
    const reports = repos.map((each) => runChecks(each, { canonRoot: env2.canonRoot }));
    console.log(options.json ? JSON.stringify(reports, null, 2) : formatReports(reports, { quiet: options.quiet }));
    process.exitCode = exitCode(reports);
  });
}

// cli/src/enforce/checks/gate.command.ts
