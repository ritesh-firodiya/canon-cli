function flow(workspace, product, sessions, formerly = [], github = gh) {
  const repo = join42(workspace, product);
  const pipeline2 = loadConfig(repo).config.pipelines.default;
  const stages = pipeline2.map((stage2) => stage2.id);
  const custom2 = customStages(pipeline2);
