// cli/src/enforce/checks/locks.ts
function holds(locked, resolved2) {
  if (Array.isArray(locked)) return Array.isArray(resolved2) && locked.every((item, index) => holds(item, resolved2[index]));
  if (locked && typeof locked === "object") {
    return Boolean(resolved2) && Object.entries(locked).every(([key2, value]) => holds(value, resolved2[key2]));
  }
  return locked === resolved2;
}
var locks = {
  id: "locks",
  module: null,
  description: "no lower layer changes or removes a value a higher layer locked",
  run({ config: config2 }) {
    return config2.locks.filter((lock) => !holds(lock.value, valueAt(config2, lock.key))).map((lock) => ({
      check: "locks",
      level: "error",
      file: ".context/context.yaml",
      message: `${lock.key} is locked by ${lock.layer}${lock.value === void 0 ? ", which does not set it" : ""}; a lower layer changed or removed it`
    }));
  }
};

