{
  "name": "zeno-cli",
  "version": "0.7.0",
  "private": true,
  "description": "zeno CLI: set up, check and sync product repos against the shared standards.",
  "type": "module",
  "bin": {
    "zeno": "./src/index.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "zeno": "node src/index.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
