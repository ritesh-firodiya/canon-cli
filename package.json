{
  "name": "@freetesh/canon",
  "version": "0.15.0",
  "description": "canon CLI: keep your domain knowledge and AI rules in your repo, and enforce them.",
  "license": "MIT",
  "author": "Ritesh Firodiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritesh-firodiya/canon-cli.git"
  },
  "type": "module",
  "exports": {
    "./api": "./cli/dist/api.js"
  },
  "bin": {
    "canon": "cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "standards",
    "skills",
    "packs",
    "templates",
    "scripts/log-verdict.mjs",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "canon": "node cli/src/index.ts",
    "check": "node cli/src/index.ts check . && pnpm typecheck && pnpm test",
    "build": "rm -rf cli/dist && tsc -p cli/tsconfig.build.json",
    "test": "vitest run --root cli",
    "coverage": "vitest run --root cli --coverage",
    "typecheck": "tsc -p cli",
    "prepack": "pnpm build",
    "release": "bash scripts/publish.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "18.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
